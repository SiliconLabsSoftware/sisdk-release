id: log_backend_iostream_formatted
label: Log Backend I/O Stream – Formatted Output
package: platform_core
description: >
  Human-readable text output for the I/O Stream log backend. Event logs emit
  hex-encoded fields terminated with CRLF. String logs expand printf-style
  specifiers and emit CRLF only when present in the payload. Log level is not printed. Optional
  leading bracket prefix (timestamp and/or log type) is configured in
  sl_log_formatted_iostream_config.h. Requires the log_backend_iostream
  component for transport.
  Formatted strings are currently supported only for host logs.
  Captive core logs do not support formatted output; instead, they are emitted
  in an encoded form and require a post processing script for decoding and interpretation.
category: Services|Log
quality: evaluation
metadata:
  sbom:
    license: Zlib
provides:
- name: log_backend
- name: log_backend_iostream_impl
- name: log_backend_iostream_formatted
  condition: [device_si91x]
requires:
- name: iostream_recommended_console
- name: log
- name: log_platform_core
- name: log_backend_iostream
root_path: platform_core/platform/service/sl_log
config_file:
- path: config/sl_log_common_config.h
  unless: [device_si91x]
- path: config/sl_log_platform_core_config.h
  condition: [device_has_timer]
- path: config/sl_log_formatted_iostream_config.h
source:
- path: backend/iostream/src/sl_log_backend_iostream_formatted.c
template_contribution:
- name: log_section_enable
  value: 1
- name: component_catalog
  value: log_default_ring_buffer
- name: component_catalog
  value: log_formatted_output
