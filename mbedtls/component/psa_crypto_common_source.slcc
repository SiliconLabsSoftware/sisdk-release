id: psa_crypto_common_source
package: mbedtls
label: Common Source
description: PSA Crypto client common (psa_crypto_client.c). Secure / Unaware only.
category: Platform|Security|PSA Crypto
quality: production
ui_hints:
  visibility: never
provides:
- name: psa_crypto_common_source
conflicts:
- name: trustzone_nonsecure
requires:
- name: psa_crypto_api
source:
- path: library/psa_crypto_client.c
include:
- path: library
  file_list:
  - path: bignum_core_invasive.h
  - path: common.h

metadata:
  sbom:
    reference: mbedtls_sbom
root_path: mbedtls
