project_name: se_manager_hash
package: platform
quality: production
label: Platform Security - SoC SE Manager Hash
description: >
  Demonstrates how to compute message digests with the SE Manager Hash API, exercising SHA-1 and SHA-2 in one-shot and streaming modes with test-vector verification on Secure Vault devices.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Advanced"]
source:
  - path: app_init.c
  - path: app_process.c
  - path: app_se_manager_hash.c
include:
  - path: .
    file_list:
    - path: app_init.h
    - path: app_process.h
    - path: app_se_manager_macro.h
    - path: app_se_manager_hash.h
readme:
  - path: readme.md
ui_hints:
  highlight:
    - path: readme.md
      focus: true
component:
  - id: sl_string
  - id: status_string
  - id: se_manager
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: printf
  - id: iostream_retarget_stdio
  - id: iostream_recommended_stream
  - id: toolchain_llvm_lto
    condition: [toolchain_llvm]
requires:
  - name: device_has_semailbox
configuration:
  - name: SL_STATUS_STRING_ENABLE_BLUETOOTH
    value: 0
  - name: SL_STATUS_STRING_ENABLE_WIFI
    value: 0
  - name: SL_CLOCK_MANAGER_HFRCO_BAND
    value: 38000000
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
define:
  - name: DEBUG_EFM
  - name: SE_MANAGER_PRINT
toolchain_settings:
  - option: optimize
    value: size
