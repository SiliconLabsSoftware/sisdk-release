id: dma_descriptor_allocator
label: DMA Descriptor Allocator
package: platform_core
description: >
  Configurable DMA descriptor allocator abstraction layer. Provides APIs to
  allocate and free DMA descriptors, allowing different allocation strategies
  to be used (e.g., memory manager for SiSDK, custom allocators for other
  platforms like Zephyr).
category: Platform|Driver|DMA
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/driver/dma_channel/
include:
- path: inc
  file_list:
  - path: sl_dma_descriptor_allocator.h
  - path: sl_dma_channel.h
source:
- path: src/sl_dma_descriptor_allocator.c
requires:
- name: memory_manager
- name: device_peripheral
- name: status
- name: component_catalog
- name: sl_assert
provides:
- name: dma_descriptor_allocator

