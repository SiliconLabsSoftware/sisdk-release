id: dma_manager_round_robin
label: 'DMA Manager: Round-Robin Channel Scheduling'
package: platform_core
description: >
  Enables round-robin channel scheduling for the DMA Manager. When this component
  is included, a configurable number of DMA channels use round-robin arbitration
  instead of fixed-priority. The number of round-robin channels is set at
  initialization time via the SL_DMA_MANAGER_ROUND_ROBIN_CHANNEL_COUNT configuration.
category: Services|DMA Manager
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: dma_manager_round_robin
  condition: [device_sdid_200]
- name: dma_manager_round_robin
  condition: [device_sdid_205]
- name: dma_manager_round_robin
  condition: [device_sdid_210]
- name: dma_manager_round_robin
  condition: [device_sdid_215]
- name: dma_manager_round_robin
  condition: [device_sdid_220]
- name: dma_manager_round_robin
