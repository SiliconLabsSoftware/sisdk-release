id: mbedtls_x509_csr_parse
package: platform_core
label: X.509 CSR Parsing
description: >-
  This component provides full support for Certificate Signing Request (CSR)
  parsing in Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_x509_csr_parse
requires:
- name: mbedtls_x509_use
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_X509_CSR_PARSE_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
