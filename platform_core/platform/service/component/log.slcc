id: log
label: Log Component
package: platform_core
description: >
  The Debug Logger System is designed to provide a reliable, efficient, and synchronized mechanism  for capturing and transmitting system logs from both the Host MCU and the Captive Core,  which handles subsystems like Wi-Fi and Bluetooth Low Energy (BLE). This logger supports real-time debugging,
  performance analysis, and error tracking in embedded applications.
category: Services|Log
quality: evaluation
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
provides:
- name: log
requires:
- name: log_none
root_path: platform_core/platform/service/sl_log
source:
- path: src/sl_log.c
template_contribution:
- name: event_handler
  value:
    event: service_init
    include: sl_log.h
    handler: sl_log_init_stage2
  priority: 9999
- name: sl_log_module_present
  value: true
- name: component_catalog
  value: log_component
