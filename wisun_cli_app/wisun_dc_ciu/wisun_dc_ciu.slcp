project_name: wisun_dc_ciu
label: Wi-SUN - SoC DC CIU
description: >
  Wi-SUN Direct Connect Control Interface Unit.
  Simple button-driven interface for DC client operations.
category: Wi-SUN Examples
filter:
  - name: "Wireless Technology"
    value: ["Wi-SUN"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]

package: wisun
quality: production

readme:
  - path: readme.md

source:
  - path: app.c
  - path: app_cli.c

include:
  - path: .
    file_list:
      - path: app_cli.h

requires:
  - name: memory_manager
  - name: power_manager
  - name: freertos

component:
  # Wi-SUN
  - id: wisun_stack
  - id: wisun_stack_debug
  - id: wisun_default_radioconf
  - id: wisun_stack_dc_client

  # platform
  - id: sl_main
  - id: device_init
  - id: sleeptimer
  - id: nvm3_default

  # Display
  - id: glib

  # Buttons
  - id: simple_button
    instance: [btn0, btn1]

  # Serial output
  - id: iostream_recommended_stream
  - id: iostream_retarget_stdio
  - id: iostream_stdlib_config
  - id: cli
    instance: [vcom]
  - id: printf

configuration:
  - name: "SL_BOARD_ENABLE_VCOM"
    value: "1"
  - name: "SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE"
    value: "usartHwFlowControlCtsAndRts"
    condition: [iostream_usart]
  - name: "SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF"
    value: "1"
    condition: [iostream_usart]
  - name: SL_IOSTREAM_EUSART_INSTANCE_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0
    condition: [iostream_eusart]
  - name: SL_IOSTREAM_EUSART_VCOM_BAUDRATE
    value: 9600
    condition: [iostream_eusart]
  - name: SL_IOSTREAM_EUSART_VCOM_ENABLE_HIGH_FREQUENCY
    value: 0
    condition: [iostream_eusart]
  - name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "true"
    condition: [iostream_eusart]
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0       # Disable this so that the chip can enter EM2/3/4
                   # and be woken by other wake sources, setting this
                   # to true adds an EM1 requirement to the Power Manager.
    condition: [iostream_eusart]
  - name: SL_IOSTREAM_EUSART_VCOM_RX_BUFFER_SIZE
    value: "64"  # Minimal for DC CIU CLI; use 128 if long commands or paste.
    condition: [iostream_eusart]
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: "SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS"
    condition: [iostream_eusart]
  - name: SL_IOSTREAM_LEUART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "1"
    condition: [iostream_leuart]
  - name: SL_IOSTREAM_LEUART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0
    condition: [iostream_leuart]
  - name: SL_IOSTREAM_LEUART_VCOM_RX_BUFFER_SIZE
    value: "64"  # Minimal for DC CIU CLI; use 128 if long commands or paste.
    condition: [iostream_leuart]
  - name: CPU_CFG_TS_32_EN
    value: "1"
  - name: OS_CFG_DBG_EN
    value: "1"
  - name: OS_CFG_TS_EN
    value: "1"
  - name: "OS_CFG_APP_HOOKS_EN"
    value: "1"
    condition: [micriumos_kernel]
  - name: SL_RAIL_UTIL_PTI_BAUD_RATE_HZ
    value: "3200000"
  - name: SL_MBEDTLS_SSL_IN_CONTENT_LEN
    value: 512
  - name: BUFFER_SIZE_UP
    value: 1024
  - name: SL_CLOCK_MANAGER_EUSART0CLK_SOURCE
    value: CMU_EUSART0CLKCTRL_CLKSEL_LFXO
    condition: [iostream_eusart]
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 1536
  - name: SL_RAIL_UTIL_SFM_SEQUENCER_SUN_MODULATIONS_SELECTION
    value: "SL_RAIL_UTIL_SFM_SEQUENCER_SUN_MODULATIONS_OFDM"
    condition: [device_sdid_220]
  - name: SL_SLEEPTIMER_WALLCLOCK_CONFIG
    value: 1

toolchain_settings:
  - option: optimize
    value: size

template_contribution:
# -------------------------------
# DC CLI command group
# -------------------------------
  - name: "cli_group"
    value:
      name: "dc"
      help: "DC CIU commands"
      shortcuts:
        - name: "d"
# -------------------------------
# dc get [setting] - Get settings
# -------------------------------
  - name: "cli_command"
    value:
      group: "dc"
      name: "get"
      handler: "app_cli_get_cmd"
      help: "Get DC CIU setting(s): dc get [setting]"
      shortcuts:
        - name: "g"
      argument:
        - type: wildcard
          help: "empty | help | <setting>"
# -------------------------------
# dc set <setting> <value> - Set a setting
# -------------------------------
  - name: "cli_command"
    value:
      group: "dc"
      name: "set"
      handler: "app_cli_set_cmd"
      help: "Set DC CIU setting: dc set <setting> <value>"
      shortcuts:
        - name: "s"
      argument:
        - type: wildcard
          help: "empty | help | <setting> <value>"
# -------------------------------
# dc save - Save settings to NVM
# -------------------------------
  - name: "cli_command"
    value:
      group: "dc"
      name: "save"
      handler: "app_cli_save_cmd"
      help: "Save settings to NVM"
# -------------------------------
# dc reset - Reset settings to defaults
# -------------------------------
  - name: "cli_command"
    value:
      group: "dc"
      name: "reset"
      handler: "app_cli_reset_cmd"
      help: "Reset settings to defaults"
# -------------------------------
# dc status - Show current status
# -------------------------------
  - name: "cli_command"
    value:
      group: "dc"
      name: "status"
      handler: "app_cli_status_cmd"
      help: "Show current application status"
      shortcuts:
        - name: "st"

ui_hints:
  highlight:
    - path: readme.md
      focus: true

