id: toolchain_gcc_standard_impl
label: GCC Toolchain Standard Linker
package: platform_core
description: Provides the GCC Standard linker file.
category: Platform|Toolchain
quality: production
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
root_path: platform_core/platform/common
provides:
- name: toolchain_gcc_standard_impl
  condition: [device_cortexm, device_series_2]

- name: toolchain_gcc_standard_impl
  condition: [cortexm33, device_series_3]

- name: toolchain_gcc_standard_impl
  condition: [device_host]
requires:
- name: toolchain_gcc_standard
template_file:
- path: toolchain/cortexm/gcc/s2/linkerfile.ld.jinja
  condition: [device_cortexm, device_series_2]
- path: toolchain/cortexm/gcc/s30/bootloader/linkerfile.ld.jinja
  condition: [btl_core, cortexm33, device_series_3]
- path: toolchain/cortexm/gcc/s30/linkerfile.ld.jinja
  condition: [cortexm33, device_series_3]
  unless: [btl_core]
