id: mic_i2s_driver
package: boards
label: I2S Microphone
description: >
  Sound level I2S microphone driver
category: Platform|Board Drivers
quality: production
metadata:
  sbom:
    license: Zlib
root_path: boards/hardware/driver/mic
provides:
- name: mic_driver_implementation
- name: mic_i2s_driver
requires:
- name: clock_manager_runtime
- name: hal_usart
- name: hal_ldma
- name: gpio
- name: dma_manager
- name: mic_driver
source:
- path: src/sl_mic_i2s.c
config_file:
- path: config/sl_mic_i2s_config.h
  file_id: mic_i2s_config
documentation:
  docset: gecko-platform
  document: platform-hardware-driver/mic
