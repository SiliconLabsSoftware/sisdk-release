id: zw_stack_release_libraries
label: Z-Wave Stack Release Libraries
category: Z-Wave
description: >
  This component includes various libraries (SiliconLabs provided Z-Wave stack)
  for 800 series processor types, both for end devices and controllers.
  This component is mandatory for the SiliconLabs provided Z-Wave sample applications and
  it is essential for the proper functioning of the Z-Wave production environment.
package: zwave
quality: production
ui_hints:
  visibility: never
metadata:
  sbom:
    reference: zw_sbom_license
provides:
- name: zw_stack_libraries
- name: zw_stack_release_libraries

library:
  # -------------------- Protocol libraries -------------------- #
  # End devices (GCC)
- path: dist/lib/libZWaveSlave_series2-gcc.a
  condition: [device_series_2, zw_end_device, toolchain_gcc]
  # End devices (LLVM)
- path: dist/lib/libZWaveSlave_series2-llvm.a
  condition: [device_series_2, zw_end_device, toolchain_llvm]
  ## Controllers (GCC)
- path: dist/lib/libZWaveController_series2-gcc.a
  condition: [device_series_2, zw_role_type_central_static_controller, toolchain_gcc]
  ## Controllers (LLVM)
- path: dist/lib/libZWaveController_series2-llvm.a
  condition: [device_series_2, zw_role_type_central_static_controller, toolchain_llvm]
  # -------------------- PAL libraries -------------------- #
  # End devices and controller applications (GCC)
- path: dist/lib/libzpal_EFR32ZG23-gcc.a
  condition: [device_family_efr32zg23, toolchain_gcc]
- path: dist/lib/libzpal_EFR32ZG28-gcc.a
  condition: [device_family_efr32zg28, toolchain_gcc]
- path: dist/lib/libzpal_ZGM23-gcc.a
  condition: [device_family_zgm23, device_is_module, toolchain_gcc]
  # PAL (LLVM)
- path: dist/lib/libzpal_EFR32ZG23-llvm.a
  condition: [device_family_efr32zg23, toolchain_llvm]
- path: dist/lib/libzpal_EFR32ZG28-llvm.a
  condition: [device_family_efr32zg28, toolchain_llvm]
- path: dist/lib/libzpal_ZGM23-llvm.a
  condition: [device_family_zgm23, device_is_module, toolchain_llvm]
root_path: zwave
