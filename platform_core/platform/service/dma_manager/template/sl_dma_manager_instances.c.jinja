#include "sl_dma_manager_instances.h"
#include "sl_dma_manager.h"
#include "sl_device_peripheral.h"

{% if dma_manager_instances is defined and dma_manager_instances %}
{% for instance in dma_manager_instances %}
sl_dma_handle_t sl_dma_handle_{{instance}};
{% endfor %}

/***************************************************************************//**
 * Initialize all configured DMA Manager instances.
 ******************************************************************************/
void sl_dma_manager_instances_init(void)
{
{% for instance in dma_manager_instances %}
  // Initialize DMA Manager instance: {{ instance | upper }}
  sl_dma_manager_init(&sl_dma_handle_{{instance}}, SL_PERIPHERAL_DMA_{{ instance | upper }});
{% endfor %}
}
{% else %}
/***************************************************************************//**
 * Initialize all configured DMA Manager instances.
 * No instances configured - function is empty.
 ******************************************************************************/
void sl_dma_manager_instances_init(void)
{
  // No DMA Manager instances configured
}
{% endif %}

