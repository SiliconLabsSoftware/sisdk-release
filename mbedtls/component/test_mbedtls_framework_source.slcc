id: test_mbedtls_framework_source
label: Test files in mbedtls-framework for Mbed TLS / PSA Crypto unit tests (Source)
package: mbedtls
description: Utility component providing mbed TLS upstream test dependencies.
category: unittest|mbedtls
quality: production
ui_hints:
  visibility: never
provides:
- name: test_mbedtls_framework_source
requires:
- name: psa_crypto_source
  condition: [trustzone_unaware]
- name: psa_crypto_source
  condition: [trustzone_secure]
source:
- path: src/asn1_helpers.c
- path: src/bignum_codepath_check.c
- path: src/bignum_helpers.c
- path: src/helpers.c
- path: src/random.c
- path: src/threading_helpers.c
- path: src/psa_crypto_helpers.c
- path: src/psa_exercise_key.c
include:
- path: include
  file_list:
  - path: test/arguments.h
  - path: test/asn1_helpers.h
  - path: test/bignum_codepath_check.h
  - path: test/bignum_helpers.h
  - path: test/constant_flow.h
  - path: test/fake_external_rng_for_test.h
  - path: test/helpers.h
  - path: test/macros.h
  - path: test/memory.h
  - path: test/psa_crypto_helpers.h
  - path: test/psa_exercise_key.h
  - path: test/psa_helpers.h
  - path: test/psa_memory_poisoning_wrappers.h
  - path: test/random.h
  - path: test/threading_helpers.h
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: mbedtls/framework/tests
