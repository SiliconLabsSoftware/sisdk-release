id: "bluetooth_common"
label: Bluetooth Low Energy Common Component
package: bluetooth_common
description: |-
  BLE common component to be used by upper BLE components

category: Bluetooth|Common
quality: production
config_file:
- path: config/sl_bluetooth_common_config.h
provides:
- name: "bluetooth_common"
include:
- path: "inc/"
  file_list:
  - path: "sli_bgcommon_debug.h"
  - path: "sli_bluetooth_common_init.h"
source:
- path: "src/sli_bgcommon_debug_efr32.c"
- path: "src/sli_bluetooth_common_config.c"
requires:
- name: memory_profiler_api
- name: bluetooth_common_libraries
recommends:
- id: "bluetooth_common_libraries_release"
  vendor: silabs
template_contribution:
- name: component_catalog
  value: bluetooth_common
metadata:
  sbom:
    license: MSLA

root_path: bluetooth_common
