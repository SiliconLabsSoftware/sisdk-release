project_name: bootloader-apploader
package: bootloader
quality: production
label: Bootloader - SoC Bluetooth AppLoader OTA DFU
description: >
  Demonstrates how to perform in-place application updates using Bluetooth AppLoader OTA DFU, in a standalone bootloader configuration over a Bluetooth connection.

category: Example|Bootloader
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]
  - name: "MCU"
    value: ["Bootloader"]


component:
  - id: bootloader_core
  - id: bootloader_apploader
  - id: bootloader_image_parser
  - id: bootloader_debug

readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
post_build:
  profile: bootloader_series_2
