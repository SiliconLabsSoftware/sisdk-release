id: micriumos_kernel_port_armv8m
label: Kernel port for ARMv8-M
package: micriumos
description: Micrium OS kernel port for ARMv8-M
category: RTOS|Micrium OS|Kernel
quality: production
metadata:
  sbom:
    license: MSLA
ui_hints:
  visibility: never
source:
- path: source/iar/armv8m_os_cpu_a.asm
  condition:
  - toolchain_iar
- path: source/gnu/armv8m_os_cpu_a.S
  condition:
  - toolchain_gcc
- path: source/gnu/armv8m_os_cpu_a.S
  condition:
  - toolchain_llvm
provides:
- name: kernel_port_armv8m_impl
  condition: [cortexm33]
- name: kernel_port_armv8m_impl
  condition: [cortexm55]
- name: kernel_port_armv8m
- name: kernel_port
  condition: [cortexm33]
- name: kernel_port
  condition: [cortexm55]
requires:
- name: kernel_port_generic
- name: component_catalog
- name: kernel_port_armv8m_common
root_path: micriumos/platform/micrium_os/ports
