id: toolchain_gcc_lto
label: Enable Link time optimization (using GCC)
package: platform_core
description: >
  This component enables Link time optimization using GCC.
  Please refer to the release notes of individual
  protocols to know which supports LTO.
category: Platform|Toolchain
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: toolchain_gcc_lto
- name: toolchain_lto
  allow_multiple: true
requires:
- name: toolchain_gcc
toolchain_settings:
- option: link_time_optimization
  value: "enabled"
  unless:
  - toolchain_lto_disable
  - toolchain_gcc_lto_disable
  - toolchain_llvm_lto_disable
template_contribution:
- name: component_catalog
  value: toolchain_gcc_lto
  unless:
  - toolchain_lto_disable
  - toolchain_gcc_lto_disable
  - toolchain_llvm_lto_disable
root_path: platform_core
