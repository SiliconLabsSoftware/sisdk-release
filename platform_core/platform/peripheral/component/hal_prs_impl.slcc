# This HAL applies to series 2 and 3 devices.
id: hal_prs_impl
label: PRS_IMPL
package: platform_core
description: >
  Peripheral Reflex System (PRS) Peripheral API implementation
category: Platform|Peripheral|HAL
ui_hints:
  visibility: never
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_prs.c
include:
- path: inc
  file_list:
  - path: sl_hal_prs.h
provides:
- name: hal_prs_impl
requires:
- name: device
- name: device_has_prs
- name: device_gpio
- name: hal_common
- name: status
- name: cmsis_core
- name: enum
- name: hal_prs
root_path: platform_core/platform/peripheral
