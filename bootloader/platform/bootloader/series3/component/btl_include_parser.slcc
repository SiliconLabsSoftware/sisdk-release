id: btl_include_parser
label: Bootloader Include Parser (Series-3)
package: bootloader
description: >
  The Bootloader Include Parser component provides image parser header files.
category: Platform|Bootloader|Core
quality: production
include:
- path: platform/bootloader/series3/parser
  file_list:
  - path: gbl/btl_gbl_parser.h
  - path: gbl/btl_gbl_format.h
  - path: gbl/btl_gbl_custom_tags.h
  # Bootloader-owned headers for series3 btl_bootload.c (not interface package).
- path: platform/bootloader/series3
  file_list:
  - path: config/btl_config.h
  - path: core/btl_bootload.h
- path: platform/bootloader
  file_list:
  - path: core/btl_reset.h
requires:
- name: bootloader_interface_headers
- name: bootloader_application_properties_header
- name: bootloader_interface_s3_bootload_headers
provides:
- name: btl_include_parser
metadata:
  sbom:
    license: MSLA
root_path: bootloader
