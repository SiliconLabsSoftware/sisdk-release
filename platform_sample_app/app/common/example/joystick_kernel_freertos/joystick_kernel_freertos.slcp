project_name: joystick_kernel_freertos
package: platform
quality: production
label: Platform - Joystick on FreeRTOS kernel
description: >
  Prints joystick position at intervals over VCOM using FreeRTOS. View output in a terminal. Requires Wireless Pro Kit (BRD4002A) as mainboard.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: app.c
  - path: app_joystick.c
include:
  - path: .
    file_list:
    - path: app.h
    - path: app_joystick.h
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: joystick
  - id: freertos
  - id: iostream_retarget_stdio
  - id: iostream_usart
    instance: [vcom]
configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
define:
  - name: DEBUG_EFM
readme:
  - path: readme.md
requires:
  - name: brd4002a
ui_hints:
  highlight: readme.md
tag:
  - hardware:component:joystick:skrhaae010
  - hwfilter:board:joystick
  - hwfilter:device:device_series_2
