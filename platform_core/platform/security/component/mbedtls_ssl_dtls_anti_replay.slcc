id: mbedtls_ssl_dtls_anti_replay
package: platform_core
label: DTLS Anti Replay
description: >-
  This component enables support for the anti-replay mechanism of DTLS in Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_ssl_dtls_anti_replay
requires:
- name: mbedtls_ssl_proto_dtls
- name: mbedtls_ssl_tls
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_SSL_DTLS_ANTI_REPLAY
documentation:
  url: https://mbed-tls.readthedocs.io/projects/api/en/development/api/file/mbedtls__config_8h/#c.MBEDTLS_SSL_DTLS_ANTI_REPLAY
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
