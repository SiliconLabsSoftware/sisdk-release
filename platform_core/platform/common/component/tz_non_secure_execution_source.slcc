id: tz_non_secure_execution_source
label: TrustZone Non-Secure Execution (Source Reference Only)
description: >
  Source build of the TrustZone non-secure handoff logic. It matches what the prebuilt
  component embeds as a byte array: the prebuilt is generated from these sources but
  linked so the image can be flashed through the Non-Secure flash alias while execution
  remains on the Secure alias. Prefer tz_non_secure_execution_prebuilt for normal
  integrations; use this component mainly as a reference and for debugging when you
  need the implementation compiled in your project.
package: platform_core
category: Platform|TrustZone
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/common
source:
- path: src/sl_tz_non_secure_execution_source.c
provides:
- name: tz_non_secure_execution_source
- name: tz_non_secure_execution_impl
  condition: [device_has_deepsleep_retention]
- name: tz_non_secure_execution_flash_only
requires:
- name: device_has_deepsleep_retention
define:
- name: SL_TZ_NON_SECURE_EXECUTION_USE_SOURCE
  value: 1
template_contribution:
- name: tz_non_secure_execution_source
  value: 1
