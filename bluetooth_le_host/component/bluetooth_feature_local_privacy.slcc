id: "bluetooth_feature_local_privacy"
label: "Local Privacy"
package: bluetooth_le_host
description: >
  Bluetooth LE local privacy feature. Enables generating Resolvable Private
  Addresses (RPA) for the local device using the local Identity Resolving
  Key (IRK) for privacy protection.
category: Bluetooth|Bluetooth Host (Stack)|Additional Features
quality: "production"
requires:
- name: "bluetooth_stack"
- name: "bluetooth_crypto"
- name: "bluetooth_crypto_lib"
provides:
- name: "bluetooth_feature_local_privacy"
template_contribution:
- name: component_catalog
  value: bluetooth_feature_local_privacy
documentation:
  docset: bluetooth
  document: bluetooth-stack-api/sl-bt-gap
metadata:
  sbom:
    license: MSLA
library:
- path: build/gcc/cortex-m33/privacy/local_privacy/release/libble_host_local_privacy.a
  condition:
  - toolchain_gcc
  - cortexm33
  - bluetooth_host_release_libraries
- path: build/gcc/cortex-m55/privacy/local_privacy/release/libble_host_local_privacy.a
  condition:
  - toolchain_gcc
  - cortexm55
  - bluetooth_host_release_libraries
- path: build/iar/cortex-m33/privacy/local_privacy/release/libble_host_local_privacy.a
  condition:
  - toolchain_iar
  - cortexm33
  - bluetooth_host_release_libraries
- path: build/iar/cortex-m55/privacy/local_privacy/release/libble_host_local_privacy.a
  condition:
  - toolchain_iar
  - cortexm55
  - bluetooth_host_release_libraries
- path: build/llvm/cortex-m33/privacy/local_privacy/release/libble_host_local_privacy.a
  condition:
  - toolchain_llvm
  - cortexm33
  - bluetooth_host_release_libraries
- path: build/llvm/cortex-m55/privacy/local_privacy/release/libble_host_local_privacy.a
  condition:
  - toolchain_llvm
  - cortexm55
  - bluetooth_host_release_libraries
root_path: bluetooth_le_host
