id: bootloader_core_nonsecure
label: Bootloader Core (Non-Secure)
package: bootloader
description: >
  Non-secure bootloader entry: adds the non-secure main file on top of
  bootloader_core_nonsecure_base. Carries NS TrustZone / interface integration requires,
  linker memory templates, default Series-2 bootloader_size (via bootloader_interface_s2),
  and toolchain settings (visible in Studio).
category: Platform|Bootloader|TrustZone NonSecure|Core
quality: production
source:
- path: platform/bootloader/core/btl_main_ns.c

define:
- name: SL_RAMFUNC_DISABLE
  value: 1
- name: __STARTUP_CLEAR_BSS
  value: 1
- name: BOOTLOADER_SECOND_STAGE
  value: 1

provides:
- name: bootloader_core
- name: bootloader_core_nonsecure

    # Used to force conflict during SLC dependency resolution
    # if other NonSecure incompatible components are being added.
- name: bootloader_nonsecure_incompatible

requires:
- name: bootloader_core_nonsecure_base
- name: bootloader_interface_s2
- name: bootloader_interface_common
- name: bootloader_interface_s2_trustzone
  condition: [trustzone_nonsecure]
- name: bootloader_tz_nonsecure
- name: emlib_msc
  condition: [device_has_msc]
- name: tz_sl_interface
- name: bootloader_aes_ctr_stream_block_cfg
  condition: [device_has_semailbox]
- name: tz_ns_interface
  condition: [bootloader_ezsp_spi_nonsecure]
- name: tz_ns_interface
  condition: [bootloader_bgapi_uartdfu_nonsecure]
- name: tz_ns_interface
  condition: [bootloader_uart_xmodem_nonsecure]
- name: tz_service_syscfg
  condition: [bootloader_apploader_nonsecure]
- name: tz_service_syscfg
  condition: [bootloader_ezsp_spi_nonsecure]
- name: tz_service_syscfg
  condition: [bootloader_bgapi_uartdfu_nonsecure]
- name: tz_service_syscfg
  condition: [bootloader_uart_xmodem_nonsecure]
- name: tz_service_syscfg
  condition: [bootloader_apploader_nonsecure]

recommends:
- id: bootloader_delay_driver_nonsecure
  vendor: silabs
- id: bootloader_ezsp_spi_nonsecure
  vendor: silabs
- id: bootloader_debug_nonsecure
  vendor: silabs
- id: bootloader_image_parser_nonsecure
  vendor: silabs
- id: bootloader_spi_peripheral_driver_nonsecure
  vendor: silabs
- id: bootloader_crc_nonsecure
  vendor: silabs
- id: bootloader_serial_driver_nonsecure
  vendor: silabs
- id: bootloader_include_parser_nonsecure
  vendor: silabs
- id: bootloader_uart_xmodem_nonsecure
  vendor: silabs
- id: bootloader_xmodem_parser_nonsecure
  vendor: silabs
- id: bootloader_bgapi_uartdfu_nonsecure

  vendor: silabs
toolchain_settings:
- option: gcc_compiler_option
  value: -std=gnu99
- option: llvm_compiler_option
  value: -std=gnu99
- option: optimize
  value: size

template_contribution:
- name: memory_flash_start
  value: 0x5000
  condition:
  - device_sdid_200     # xG21
- name: memory_flash_start
  value: 0x5000
  condition:
  - device_sdid_205     # xG22
- name: memory_flash_start
  value: 0x8005000
  condition:
  - device_sdid_210     # xG23
- name: memory_flash_start
  value: 0x8005000
  condition:
  - device_sdid_215     # xG24
- name: memory_flash_start
  value: 0x8005000
  condition:
  - device_sdid_220     # xG25
- name: memory_flash_start
  value: 0x8005000
  condition:
  - device_sdid_225     # xG26
- name: memory_flash_start
  value: 0x8005000
  condition:
  - device_sdid_230     # xG27
- name: memory_flash_start
  value: 0x8005000
  condition:
  - device_sdid_235     # xG28
- name: memory_flash_start
  value: 0x8005000
  condition:
  - device_sdid_240     # xG29
- name: memory_flash_start
  value: 0x8005000
  condition:
  - device_sdid_260     # xG2D
- name: memory_flash_start
  value: 0x8005000
  condition:
  - device_sdid_250     # xG2B

- name: memory_ram_start
  value: 0x20006000
  unless:
  - bootloader_apploader
- name: memory_ram_start
  value: 0x20002000
  condition:
  - bootloader_apploader

- name: memory_ram_size
  value: 0x2000
  unless:
  - bootloader_apploader
- name: memory_ram_size
  value: 0x6000
  condition:
  - bootloader_apploader

- name: memory_flash_size
  value: 4096
  unless:
  - bootloader_apploader
- name: memory_flash_size
  value: 0xF000
  condition:
  - bootloader_apploader
metadata:
  sbom:
    license: MSLA
root_path: bootloader
