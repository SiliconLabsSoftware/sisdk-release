project_name: watchdog_baremetal
package: platform
quality: evaluation
label: Platform - Watchdog Bare-metal
description: >
  This example project shows how Watchdog work in a baremetal project.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: app.c
  - path: watchdog.c
tag:
  - hardware:component:button:2+
  - hwfilter:board:simple_button:btn0
  - hwfilter:board:simple_button:btn1
  - hwfilter:device:device_series_2
include:
  - path: .
    file_list:
    - path: app.h
    - path: watchdog.h
component:
  - id: clock_manager
  - id: code_classification
  - id: device_init
  - id: sleeptimer
  - id: simple_button
    instance: [btn0, btn1]
  - id: sl_main
  - id: watchdog_manager
  - id: power_manager
  - id: iostream_retarget_stdio
  - id: iostream_stdlib_config
  - id: iostream_recommended_stream
  - id: udelay

configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0
    condition: [iostream_usart]
  - name: SL_IOSTREAM_UART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0
    condition: [iostream_uart]
  - name: SL_WATCHDOG_MANAGER_TIMEOUT_PERIOD
    value: SL_WATCHDOG_MANAGER_TIMEOUT_PERIOD_128M
  - name: SL_WATCHDOG_MANAGER_EM1_RUN
    value: 1
    condition: [power_manager]
define:
  - name: DEBUG_EFM
readme:
  - path: readme.md
template_contribution:
  - name: component_catalog
    priority: 0
    value: watchdog_manager
ui_hints:
  highlight: readme.md
