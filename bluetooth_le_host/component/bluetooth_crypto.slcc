id: "bluetooth_crypto"
label: "Bluetooth Core Crypto"
package: bluetooth_le_host
description: >
  Bluetooth Low Energy stack cryptographic protocol functions.

  This component provides the cryptographic operations used by the Security Manager Protocol (SMP)
  and Bluetooth privacy functionality and depends on a crypto primitive backend.
category: Bluetooth|Bluetooth Host (Stack)
quality: "production"
requires:
- name: "bluetooth_crypto_lib"
recommends:
- id: "bluetooth_crypto_lib_psa"

  vendor: silabs
provides:
- name: "bluetooth_crypto"

metadata:
  sbom:
    license: MSLA
library:
- path: build/gcc/cortex-m33/crypto/release/libble_host_crypto.a
  condition:
  - toolchain_gcc
  - cortexm33
  - bluetooth_host_release_libraries
- path: build/gcc/cortex-m55/crypto/release/libble_host_crypto.a
  condition:
  - toolchain_gcc
  - cortexm55
  - bluetooth_host_release_libraries
- path: build/iar/cortex-m33/crypto/release/libble_host_crypto.a
  condition:
  - toolchain_iar
  - cortexm33
  - bluetooth_host_release_libraries
- path: build/iar/cortex-m55/crypto/release/libble_host_crypto.a
  condition:
  - toolchain_iar
  - cortexm55
  - bluetooth_host_release_libraries
- path: build/llvm/cortex-m33/crypto/release/libble_host_crypto.a
  condition:
  - toolchain_llvm
  - cortexm33
  - bluetooth_host_release_libraries
- path: build/llvm/cortex-m55/crypto/release/libble_host_crypto.a
  condition:
  - toolchain_llvm
  - cortexm55
  - bluetooth_host_release_libraries
root_path: bluetooth_le_host
