id: dma_channel
label: DMA Channel Driver
package: platform_core
description: >
  High-level per-channel DMA driver built on top of the DMA Manager. Provides
  APIs to submit memory/peripheral transfers, multi-buffer (ping-pong / triple)
  and transfer list management with automatic descriptor handling.
category: Platform|Driver|DMA
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/driver/dma_channel/
include:
- path: inc
  file_list:
  - path: sl_dma_channel.h
  - path: sl_dma_channel_device.h
  - path: sli_dma_channel.h
source:
- path: src/sl_dma_channel.c
requires:
- name: hal_ldma
- name: device_dma
- name: device_peripheral
- name: status
- name: component_catalog
- name: dma_manager
- name: clock_manager_runtime
- name: memory_manager
- name: dma_descriptor_allocator
- name: sl_assert
- name: sl_core
provides:
- name: dma_channel
define:
- name: SL_CODE_COMPONENT_DMA_CHANNEL
  value: dma_channel
template_contribution:
- name: code_classification_components
  value: dma_channel
