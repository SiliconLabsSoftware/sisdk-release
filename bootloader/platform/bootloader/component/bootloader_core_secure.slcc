id: bootloader_core_secure
label: Bootloader Core (Secure)
package: bootloader
description: >
  Secure bootloader entry and integration: adds the secure-world main file, secure-entry
  preprocessor defines, on top of bootloader_core_secure_base. Pulls secure policy and
  validation via bootloader_core_secure_policy and bootloader_core_validation_helper. Carries
  TrustZone integration requires, linker templates, and toolchain settings (visible in Studio),
  matching bootloader_core_nonsecure.
category: Platform|Bootloader|TrustZone Secure|Core
quality: production
source:
- path: platform/bootloader/core/btl_main_s.c

define:
- name: BOOTLOADER_ENABLE
  value: 1
- name: SL_RAMFUNC_DISABLE
  value: 1
- name: __STARTUP_CLEAR_BSS
  value: 1
- name: BOOTLOADER_SECOND_STAGE
  value: 1
- name: SL_STACK_SIZE
  value: 2048
- name: SL_HEAP_SIZE
  value: 0
  # Non-Secure Memory layout
- name: NS_FLASH_OFFSET
  value: 0x5000
- name: NS_RAM_OFFSET
  value: 0x2000
  condition:
  - bootloader_apploader
- name: NS_RAM_OFFSET
  value: 0x6000
  unless:
  - bootloader_apploader
- name: SL_APP_PROPERTIES

provides:
- name: bootloader_core
- name: bootloader_core_secure

    # Used to force conflict during SLC dependency resolution
    # if other Secure incompatible components are being added.
- name: bootloader_secure_incompatible

requires:
- name: bootloader_core_secure_base
- name: bootloader_core_secure_policy
- name: bootloader_core_validation_helper
- name: device_init
  condition: [bootloader_apploader]
- name: device_init_hfxo
  condition: [bootloader_apploader]
- name: tz_sl_interface
  condition: [bootloader_apploader]
- name: tz_iovec_check
  condition: [bootloader_apploader]
- name: tz_common
  condition: [bootloader_apploader]
- name: tz_service_syscfg
- name: bootloader_tz_secure
- name: bootloader_tz_utils

recommends:
- id: bootloader_delay_driver
  vendor: silabs
- id: bootloader_ezsp_spi
  vendor: silabs
- id: bootloader_debug
  vendor: silabs
- id: bootloader_image_parser
  vendor: silabs
- id: bootloader_spi_peripheral_driver
  vendor: silabs
- id: bootloader_crc
  vendor: silabs
- id: bootloader_serial_driver
  vendor: silabs
- id: bootloader_include_parser
  vendor: silabs
- id: bootloader_uart_xmodem
  vendor: silabs
- id: bootloader_xmodem_parser
  vendor: silabs
- id: bootloader_bgapi_uartdfu

  vendor: silabs
template_contribution:
- name: bootloader_enable
  value: 1
- name: app_rollback_protection_size
  value: 0x20
- name: memory_ram_start
  value: 0x20000000
- name: memory_ram_size
  value: 0x6000
  unless:
  - bootloader_apploader
- name: memory_ram_size
  value: 0x2000
  condition:
  - bootloader_apploader

- name: bootloader_flash_addr
  value: 0x0
  condition:
  - device_sdid_200     # xG21
- name: bootloader_flash_addr
  value: 0x0
  condition:
  - device_sdid_205     # xG22
- name: bootloader_flash_addr
  value: 0x8000000
  condition:
  - device_sdid_210     # xG23
- name: bootloader_flash_addr
  value: 0x8000000
  condition:
  - device_sdid_215     # xG24
- name: bootloader_flash_addr
  value: 0x8000000
  condition:
  - device_sdid_220     # xG25
- name: bootloader_flash_addr
  value: 0x08000000
  condition:
  - device_sdid_225     # XG26
- name: bootloader_flash_addr
  value: 0x08000000
  condition:
  - device_sdid_230     # XG27
- name: bootloader_flash_addr
  value: 0x08000000
  condition:
  - device_sdid_235     # XG28
- name: bootloader_flash_addr
  value: 0x08000000
  condition:
  - device_sdid_240     # xG29
- name: bootloader_flash_addr
  value: 0x08000000
  condition:
  - device_sdid_260     # xG2D
- name: bootloader_flash_addr
  value: 0x08000000
  condition:
  - device_sdid_250     # XG2B
- name: bootloader_main_size
  value: 0x5000

toolchain_settings:
- option: gcc_compiler_option
  value: -std=gnu99
- option: llvm_compiler_option
  value: -std=gnu99
- option: optimize
  value: size
- option: trustzone_library
  value: enabled

  # CMSE import-library generation (--cmse-implib) is incompatible with GCC
  # whole-program LTO: Setting the same SLC option here to 'disabled' aims 
  # to override toolchain_lto's 'enabled' for the secure project specifically.
- option: link_time_optimization
  value: disabled
metadata:
  sbom:
    license: MSLA
root_path: bootloader
