project_name: bootloader-storage-multi-4096k
package: bootloader
quality: production
label: Bootloader - SoC Storage (Multiple OTA images of size 756kB for 4MB flash)
description: >
   Demonstrates how to configure the Gecko Bootloader to store firmware update images in flash, in a dual-slot setup with two 756 kB slots starting at 0x011FA000 and 0x12B7000.

category: Example|Bootloader
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]
  - name: "MCU"
    value: ["Bootloader"]


component:
  - id: btl_core
  - id: btl_crc
  - id: bootloader_aes_sha_ecdsa
  - id: btl_internal_storage
  - id: btl_storage_slots
  - id: btl_image_parser
  - id: btl_common_storage
  - id: bootloader_debug
  - id: clock_manager

configuration:
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 18841600
  - name: SLOT0_ENABLE
    value: 1
  - name: SLOT0_SIZE
    value: 774144
  - name: SLOT0_START
    value: 18849792
  - name: SLOT1_ENABLE
    value: 1
  - name: SLOT1_SIZE
    value: 774144
  - name: SLOT1_START
    value: 19623936
tag:
  - hardware:device:flash:3904

readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
post_build:
  profile: bootloader_series_2
