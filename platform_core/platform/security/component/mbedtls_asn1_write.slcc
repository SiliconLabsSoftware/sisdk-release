id: mbedtls_asn1_write
package: platform_core
label: ASN.1 Writer
description: >-
  This component provides support for ASN.1 writing using Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_asn1_write
requires:
- name: mbedtls_asn1_parse
- name: mbedtls_core
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_ASN1_WRITE_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
