id: wisun_alloc
label: Wi-SUN alloc
description: >
  Wi-SUN alloc is an optional application component that reserves a separate heap used for critical features needed
  to maintain the Wi-SUN network. This includes all cryptographic operations.
  The size of the heap should be dimensioned for Wi-SUN usage and any other cryptographic calls present in the
  application.
package: wisun
category: Wi-SUN|Application
quality: production


provides:
- name: mbedtls_platform_dynamic_memory_allocation_config
- name: wisun_alloc

requires:
- name: memory_manager

config_file:
- path: plugin/config/sl_wisun_alloc_config.h

source:
- path: plugin/sl_wisun_alloc.c

template_contribution:
- name: component_catalog
  value: wisun_alloc
- name: mbedtls_config
  value: MBEDTLS_PLATFORM_C
- name: mbedtls_config
  value: MBEDTLS_PLATFORM_MEMORY
- name: mbedtls_config
  value: MBEDTLS_PLATFORM_CALLOC_MACRO sl_wisun_calloc
- name: mbedtls_config
  value: MBEDTLS_PLATFORM_FREE_MACRO   sl_wisun_free

metadata:
  sbom:
    license: MSLA
root_path: wisun
