project_name: dmadrv_baremetal
package: platform
quality: production
label: Platform - DMA Bare-metal
description: >
  This example project shows how to use the DMA driver (DMA Manager and DMA Channel Driver) to transfer data between memory and a USART peripheral in a bare-metal configuration.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: app.c
  - path: dmadrv_app.c
include:
  - path: .
    file_list:
    - path: app.h
    - path: dmadrv_app.h
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: dma_manager
  - id: dma_channel
  - id: power_manager
  - id: sleeptimer
  - id: iostream
  - id: iostream_usart
    instance:
      - vcom
define:
  - name: DEBUG_EFM
configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
tag:
  - hardware:component:usart
  - hwfilter:device:device_has_uart
  - hwfilter:device:device_series_2
