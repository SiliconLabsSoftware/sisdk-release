id: mbedtls_pki
package: platform_core
label: Public-Key Abstraction Layer
description: >-
  This component provides support for the full Public Key (PK) abstraction
  layer in Mbed TLS, including encryption and decryption, signature
  generation and verification, and public key file parsing and writing.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_pki
- name: mbedtls_uses_psa_crypto
  allow_multiple: true
requires:
- name: mbedtls_pk
- name: mbedtls_pk_parse
- name: mbedtls_pk_write

  # We need either RSA or ECDSA to be enabled.
- name: mbedtls_pk_backend

# ECDSA is the most likely backend for PK signatures.
recommends:
- id: psa_crypto_ecdsa

  vendor: silabs
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
