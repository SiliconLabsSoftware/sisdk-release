project_name: bootloader-storage-spiflash-single-1024k
package: bootloader
quality: production
label: Bootloader - SoC SPI Flash Storage (single image with slot size of 1024kB)
description: >
  Demonstrates how to configure the Gecko Bootloader to store firmware update images using external SPI flash, in a single-slot setup with a 1024 kB slot starting at 0x0.

category: Example|Bootloader
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]
  - name: "MCU"
    value: ["Bootloader"]

component:
  - id: bootloader_core
  - id: bootloader_crc
  - id: bootloader_aes_sha_ecdsa
  - id: bootloader_delay_driver
  - id: bootloader_image_parser
  - id: bootloader_common_storage_single
  - id: bootloader_token_management
  - id: bootloader_spiflash_storage
  - id: bootloader_spi_controller_driver
  - id: bootloader_debug

configuration:
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 0
  - name: SLOT0_ENABLE
    value: 1
  - name: SLOT0_START
    value: 0
  - name: SLOT0_SIZE
    value: 1048576

tag:
  - hardware:component:memory:spi

readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
post_build:
  profile: bootloader_series_2
