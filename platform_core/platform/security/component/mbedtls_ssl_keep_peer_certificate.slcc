id: mbedtls_ssl_keep_peer_certificate
package: platform_core
label: SSL Keep Peer Certificate
description: >-
  This component provides support for using TLS (as a client) in Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_ssl_keep_peer_certificate
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_SSL_KEEP_PEER_CERTIFICATE
documentation:
  url: https://mbed-tls.readthedocs.io/projects/api/en/development/api/file/mbedtls__config_8h/#c.MBEDTLS_SSL_KEEP_PEER_CERTIFICATE
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
