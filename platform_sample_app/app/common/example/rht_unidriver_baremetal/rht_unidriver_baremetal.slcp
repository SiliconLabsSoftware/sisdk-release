project_name: rht_unidriver_baremetal
package: platform
quality: production
label: Platform - RHT UniDriver Bare-metal
description: >
  Bare-metal example that exercises the RHT UniDriver API for the on-board Si70xx (e.g. Wireless Pro Kit BRD4002A) or SHT4x (WPK BRD4002B). Prints discovery, optional API status codes, and periodic RH/T over VCOM.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: app.c
  - path: rht_unidriver_app.c
include:
  - path: .
    file_list:
    - path: app.h
    - path: rht_unidriver_app.h
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: i2cspm
    instance: [sensor]
  - id: rht_unidriver_driver
  - id: sleeptimer
  - id: iostream_stdlib_config
  - id: iostream_retarget_stdio
  - id: iostream_recommended_stream
define:
  - name: DEBUG_EFM
readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
tag:
  - hardware:component:sensor:si7021
  - hardware:component:sensor:sht40-ad1f-r2
  - hwfilter:board:hardware_board_has_tempsensor
  - hwfilter:device:device_series_2
configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_BOARD_ENABLE_SENSOR_RHT
    value: 1
