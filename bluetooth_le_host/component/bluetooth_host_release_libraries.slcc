  - toolchain_gcc
  - cortexm33
  - bluetooth_feature_cs_test
- path: build/gcc/cortex-m33/channel_sounding/release/libble_host_channel_sounding.a
  condition:
  - toolchain_gcc
  - cortexm33
  - bluetooth_feature_cs
- path: build/gcc/cortex-m33/connection/connection_analyzer/release/libble_host_connection_analyzer.a
  condition:
  - toolchain_gcc
  - cortexm33
  - bluetooth_feature_connection_analyzer
