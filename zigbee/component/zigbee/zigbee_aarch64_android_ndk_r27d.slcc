id: zigbee_aarch64_android_ndk_r27d
label: Zigbee ARM64 (Android 15 - NDK r27d)
package: zigbee
category: Zigbee
quality: production
description: This plugin contains defines to build Zigbee apps against ARM64, with Android r27d NDK (Android 15, API 35).

provides:
- name: aarch64-android-ndk-r27d
- name: zigbee_aarch64_android_ndk_r27d

requires:
- name: linux_arch_aarch64

template_contribution:
- name: component_catalog
  value: zigbee_aarch64_android_ndk_r27d

validation_helper:
- path: component/scripts/zigbee_linux_arch_validation.lua

documentation:
  docset: zigbee
  document: zigbee-af-api/aarch64_ndk_r27d
metadata:
  sbom:
    license: MSLA
root_path: zigbee
