id: btl_euart
label: Bootloader EUART Extension Component
package: bootloader
description: >
  Extension component providing EUART functionality for bootloader.
category: Platform|Bootloader|Utils
quality: production
source:
- path: "platform/bootloader/driver/btl_driver_util.c"
include:
- path: platform/bootloader/driver
  file_list:
  - path: btl_driver_util.h
requires:
- name: bootloader_interface_common
provides:
- name: btl_euart
config_file:
- path: platform/bootloader/config/btl_uart_driver_cfg.h
  file_id: btl_uart_driver_cfg
- path: "platform/bootloader/config/device_series_2/btl_core_cfg.h"
metadata:
  sbom:
    license: MSLA
ui_hints:
  visibility: never

root_path: bootloader
