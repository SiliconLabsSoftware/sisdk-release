id: bootloader_include_parser_nonsecure
label: Bootloader Include Parser (Non-Secure)
package: bootloader
description: >
  The Bootloader Include Parser (Non-Secure) component provides image parser header files.
category: Platform|Bootloader|TrustZone NonSecure|Core
quality: production
include:
- path: platform/bootloader
- path: platform/bootloader/parser
  file_list:
  - path: gbl/btl_gbl_parser_ns.h
requires:
- name: bootloader_interface_common
provides:
- name: bootloader_include_parser
- name: bootloader_include_parser_nonsecure
metadata:
  sbom:
    license: MSLA
root_path: bootloader
