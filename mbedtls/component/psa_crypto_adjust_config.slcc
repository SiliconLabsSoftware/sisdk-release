id: psa_crypto_adjust_config
package: mbedtls
label: PSA Crypto Config Adjust Headers
description: >-
  Shared PSA build-info and config-adjust headers required by
  `mbedtls/config_psa.h` include chains across TrustZone Secure,
  TrustZone Unaware, and TrustZone Non-Secure builds.
category: Platform|Security|Mbed TLS
quality: production
ui_hints:
  visibility: never
provides:
- name: psa_crypto_adjust_config
include:
- path: include
  file_list:
  - path: psa/build_info.h
  - path: psa/crypto_adjust_auto_enabled.h
  - path: psa/crypto_adjust_config_dependencies.h
  - path: psa/crypto_adjust_config_key_pair_types.h
  - path: psa/crypto_adjust_config_synonyms.h
  - path: psa/crypto_legacy.h

metadata:
  sbom:
    reference: mbedtls_sbom
root_path: mbedtls
