id: mbedtls_key_exchange_ecdhe_psk
package: platform_core
label: ECDHE-Based Key Exchange
description: >-
  This component Enable the ECDHE-PSK based ciphersuite modes in SSL / TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production

provides:
- name: mbedtls_key_exchange_ecdhe_psk
- name: mbedtls_key_exchange
  allow_multiple: true

requires:
- name: mbedtls_ssl_tls
- name: psa_crypto_ecdh

template_contribution:
- name: mbedtls_config
  value: MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
