id: "bluetooth_common_libraries_release"
package: bluetooth_common
description: |-
  BLE common libraries to be used by upper BLE components

category: Bluetooth|Common
quality: production
provides:
- name: "bluetooth_common_libraries"
- name: "bluetooth_common_libraries_release"
ui_hints:
  visibility: never
library:
- path: lib/build/gcc/cortex-m33/bgcommon/release/libbgcommon.a
  condition:
  - toolchain_gcc
  - cortexm33
- path: lib/build/gcc/cortex-m55/bgcommon/release/libbgcommon.a
  condition:
  - toolchain_gcc
  - cortexm55
- path: lib/build/iar/cortex-m33/bgcommon/release/libbgcommon.a
  condition:
  - toolchain_iar
  - cortexm33
- path: lib/build/iar/cortex-m55/bgcommon/release/libbgcommon.a
  condition:
  - toolchain_iar
  - cortexm55
- path: lib/build/llvm/cortex-m33/bgcommon/release/libbgcommon.a
  condition:
  - toolchain_llvm
  - cortexm33
- path: lib/build/llvm/cortex-m55/bgcommon/release/libbgcommon.a
  condition:
  - toolchain_llvm
  - cortexm55
metadata:
  sbom:
    license: MSLA
root_path: bluetooth_common
