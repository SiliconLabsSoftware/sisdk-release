project_name: ledsink_baremetal
package: platform
quality: evaluation
label: Platform - LEDSINK Bare-metal
description: >
  This example project demonstrates how to use the LEDSINK peripheral with hardware pattern generation with no PWM,
  PWM brightness, software direct drive, and a button-triggered EM2 deep-sleep test in a bare-metal configuration.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: app.c
  - path: ledsink_baremetal.c
include:
  - path: .
    file_list:
    - path: app.h
    - path: ledsink_baremetal.h
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: sleeptimer
  - id: power_manager
  - id: hal_ledsink
  - id: simple_button
    instance: [btn0]
define:
  - name: DEBUG_EFM
readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
tag:
  - hardware:component:led:4
  - hardware:component:button:1+
  - hwfilter:board:simple_button:btn0
