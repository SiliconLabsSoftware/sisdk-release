id: rtllib_api
label: Real-Time Locationing Library API
package: realtime_locationing
description: Real time locationing API
category: Bluetooth|Direction Finding
quality: production
metadata:
  sbom:
    license: MSLA
root_path: realtime_locationing/.
provides:
- name: rtllib_api
include:
- path: inc
  file_list:
  - path: sl_rtl_clib_api.h
- path: clib/api/inc
  file_list:
  - path: sli_rtl_clib_cs_api.h
  - path: sli_rtl_clib_ras_api.h
source:
- path: clib/api/src/sl_rtl_clib_cs_api.c
- path: clib/api/src/sl_rtl_clib_ras_api.c

documentation:
  docset: rtl-lib
  document: modules
