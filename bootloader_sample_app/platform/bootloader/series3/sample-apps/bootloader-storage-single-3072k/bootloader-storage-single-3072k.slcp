project_name: bootloader-storage-single-3072k
package: bootloader
quality: production
label: Bootloader - SoC Storage (single OTA image of size 1180kB for 3MB flash)
description: >
  Demonstrates how to configure the Gecko Bootloader to store firmware update images in flash, in a single-slot setup with a 1180 kB slot starting at 0x01168000.

category: Example|Bootloader
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]
  - name: "MCU"
    value: ["Bootloader"]


component:
  - id: btl_core
  - id: btl_crc
  - id: bootloader_aes_sha_ecdsa
  - id: btl_internal_storage
  - id: btl_storage_slots
  - id: btl_image_parser
  - id: btl_common_storage
  - id: bootloader_debug
  - id: clock_manager

configuration:
  - name: SLOT0_ENABLE
    value: 1
  - name: SLOT0_SIZE
    value: 1208320
  - name: SLOT0_START
    value: 18251776
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 18251776
tag:
  - hardware:device:flash:3072

readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
post_build:
  profile: bootloader_series_2
