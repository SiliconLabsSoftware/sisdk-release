id: bootloader_internal_storage
label: Internal Storage
package: bootloader
description: >
  The Bootloader Internal Storage is a storage component using internal flash. With this component
  included, during upgrade image is stored in the internal flash during the upgrade process.
  DMA channel can be configured for DMA-based MSC write.
category: Platform|Bootloader|Storage
quality: production
source:
- path: platform/bootloader/storage/internal_flash/btl_storage_internal_flash.c
include:
- path: platform/bootloader
define:
- name: BOOTLOADER_SUPPORT_STORAGE
  value: 1
- name: BOOTLOADER_SUPPORT_INTERNAL_STORAGE
  value: 1
provides:
- name: bootloader_internal_storage
- name: bootloader_nonsecure_incompatible
  condition: [bootloader_core_nonsecure]
requires:
- name: bootloader_interface_common
- name: bootloader_crc
config_file:
- path: platform/bootloader/config/btl_internal_storage_cfg.h
  file_id: btl_internal_storage_config
- path: platform/bootloader/config/internal_storage_slot_cfg/btl_storage_slot_cfg_default.h
  override:
    component: bootloader_storage_slots
    file_id: btl_storage_slot_cfg_default
    vendor: silabs
  unless: [btl_storage_slot_cfg_default_override]
template_file:
- path: platform/bootloader/config/internal_storage_slot_cfg/btl_internal_storage_slot_cfg_default.h.jinja
  unless: [btl_storage_slot_cfg_default_override]
metadata:
  sbom:
    license: MSLA
root_path: bootloader
