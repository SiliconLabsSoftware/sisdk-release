id: mbedtls_x509_crt_parse
package: platform_core
label: X.509 Parse Certificates
description: >-
  This component provides support for parsing X.509 standard-
  based certificates in Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_x509_crt_parse
requires:
- name: mbedtls_x509_use
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_X509_CRT_PARSE_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
