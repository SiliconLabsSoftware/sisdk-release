id: power_manager_core_common
label: 'Power Manager: Core Common'
package: platform_core
description: Power Manager core Common files(no handler generation)
category: Services|Power Manager
quality: production
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
root_path: platform_core/platform/service/power_manager/
include:
- path: inc
  file_list:
  - path: sl_power_manager.h
  - path: sl_power_manager_debug.h
  - path: sli_power_manager.h
  - path: sl_power_manager_execution_modes.h
    condition: [device_series_3]
- path: src/common
  file_list:
  - path: sli_power_manager_common_private.h
  - path: sli_power_manager_execution_modes_private.h
    condition: [device_series_3]
source:
- path: src/common/sl_power_manager_common.c
- path: src/common/sl_power_manager_execution_modes.c
  condition: [device_series_3]
provides:
- name: power_manager_core_common
requires:
- name: sl_core
- name: sl_assert
- name: status
- name: slist
- name: atomic
- name: enum
- name: sleeptimer
- name: code_classification
