id: nvm3_crypto_se
label: NVM3 HAL for SE crypto
package: platform_core
description: >
  NVM3 crypto HAL for crypto HW on SE subsystem.
category: Services|NVM3
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: platform/emdrv/nvm3/src/nvm3_hal_crypto_se.c
  unless: [trustzone_nonsecure]
provides:
- name: nvm3_crypto_se
requires:
- name: nvm3_hal_crypto
- name: se_manager
ui_hints:
  visibility: never
root_path: platform_core
