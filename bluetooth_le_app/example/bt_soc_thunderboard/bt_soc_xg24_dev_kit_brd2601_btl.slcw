workspace_name: bt_soc_xg24_dev_kit_brd2601_btl
label: Bluetooth - SoC EFR32xG24 Dev Kit (BRD2601) + AppLoader OTA DFU
package: bluetooth_le_app
description: >-
  Demonstrates the features of the EFR32xG24 Dev Kit Board.
  This can be tested with the Simplicity Connect mobile app.
  Combined solution with application and bootloader projects.
quality: production
project:
  - path: bt_soc_xg24_dev_kit_brd2601.slcp
    id: application
  - path: ../../bootloader/bootloader-apploader.slcp
    id: bootloader
post_build:
  path: ../../postbuild_profile/bt_dfu_ws.slpb
