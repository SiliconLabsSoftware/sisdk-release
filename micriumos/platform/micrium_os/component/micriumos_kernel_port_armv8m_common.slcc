id: micriumos_kernel_port_armv8m_common
label: Kernel port for ARMv8-M Common component
package: micriumos
description: Micrium OS kernel port for ARMv8-M
category: RTOS|Micrium OS|Kernel
quality: production
metadata:
  sbom:
    license: MSLA
ui_hints:
  visibility: never
source:
- path: source/iar/armv8m_os_cpu_c.c
  condition:
  - toolchain_iar
- path: source/gnu/armv8m_os_cpu_c.c
  condition:
  - toolchain_gcc
- path: source/gnu/armv8m_os_cpu_c.c
  condition:
  - toolchain_llvm
include:
- path: source
  file_list:
    # iar
  - path: iar/armv8m_os_cpu.h
    condition:
    - toolchain_iar
    # gcc
  - path: gnu/armv8m_os_cpu.h
    condition:
    - toolchain_gcc
  - path: gnu/armv8m_os_cpu.h
    condition:
    - toolchain_llvm
provides:
- name: kernel_port_armv8m_common
requires:
- name: kernel_port_generic
- name: component_catalog
- name: kernel_port_armv8m_impl
root_path: micriumos/platform/micrium_os/ports
