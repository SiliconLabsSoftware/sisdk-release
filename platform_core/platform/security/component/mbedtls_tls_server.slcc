id: mbedtls_tls_server
package: platform_core
label: TLS Server
description: >-
  This component provides support for using TLS (as a server) in Mbed TLS.
  This component is DEPRECATED and will be removed in a future version of this product.
  This component will be replaced by the new component called mbedtls_ssl_server.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_tls_server
requires:
- name: mbedtls_tls
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_SSL_SRV_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
