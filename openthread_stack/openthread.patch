+    VerifyOrExit(mDnssdState == OT_PLAT_DNSSD_READY);
+
+    SuccessOrExit(mEncoder.BeginFrame(header, cmd, aPropKey));
+    SuccessOrExit(Spinel::EncodeDnssdDiscovery(mEncoder, *aDiscovery));
+    SuccessOrExit(mEncoder.EndFrame());
+
+exit:
+    return;
+}
