project_name: bootloader-storage-spiflash
package: bootloader
quality: production
label: Bootloader - SoC SPI Flash Storage (multiple images)
description: >
  Demonstrates how to configure the Gecko Bootloader to store firmware update images using external SPI flash, in a dual-slot setup with two 252 kB slots starting at 0x2000 and 0x41000.

category: Example|Bootloader
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]
  - name: "MCU"
    value: ["Bootloader"]


component:
  - id: bootloader_core
  - id: bootloader_crc
  - id: bootloader_aes_sha_ecdsa
  - id: bootloader_delay_driver
  - id: bootloader_image_parser
  - id: bootloader_common_storage
  - id: bootloader_token_management
  - id: bootloader_spiflash_storage
  - id: bootloader_spi_controller_driver
  - id: bootloader_debug

configuration:
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 0
  - name: SLOT0_ENABLE
    value: 1
  - name: SLOT0_START
    value: 8192
  - name: SLOT0_SIZE
    value: 258048
  - name: SLOT1_ENABLE
    value: 1
  - name: SLOT1_START
    value: 266240
  - name: SLOT1_SIZE
    value: 258048

tag:
  - hardware:component:memory:spi

readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
post_build:
  profile: bootloader_series_2
