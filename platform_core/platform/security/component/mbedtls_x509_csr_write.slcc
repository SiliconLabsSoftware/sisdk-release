id: mbedtls_x509_csr_write
package: platform_core
label: X.509 CSR Creating
description: >-
  This component provides full support for creating X.509 Certificate Signing
  Requests (CSR) in Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_x509_csr_write
requires:
- name: mbedtls_x509_create
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_X509_CSR_WRITE_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
