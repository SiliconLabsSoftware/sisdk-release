id: zigbee_direct_stack_interface
label: IPC Interface for Zigbee Direct
package: zigbee
description: Zigbee Stack Handlers for Zigbee Direct.
category: Zigbee|Zigbee Direct ZDD
quality: production
ui_hints:
  visibility: never

provides:
- name: zigbee_direct_stack_interface

requires:
- name: zigbee_stack_common

source:
- path: stack/internal/src/baremetal/zigbee_direct_stack_interface_baremetal_wrapper.c
  unless:
  - zigbee_use_ipc
- path: stack/internal/src/stubs/zigbee_direct_stack_interface_internal_weak_stubs.c
- path: stack/internal/src/ipc/zigbee_direct_stack_interface_ipc_command_messages.c
  condition:
  - zigbee_use_ipc

include:
- path: stack/include
  file_list:
  - path: zigbee_direct_stack_interface.h
- path: stack/internal/inc
  file_list:
  - path: zigbee_direct_stack_interface_internal_def.h
- path: stack/internal/src/ipc
  file_list:
  - path: zigbee_direct_stack_interface_ipc_command_messages.h
    condition:
    - zigbee_use_ipc

template_contribution:
- name: component_catalog
  value: zigbee_direct_stack_interface

metadata:
  sbom:
    license: MSLA
root_path: zigbee
