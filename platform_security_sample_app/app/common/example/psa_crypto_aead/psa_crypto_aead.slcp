project_name: psa_crypto_aead
package: platform
quality: production
label: Platform Security - SoC PSA Crypto AEAD
description: >
  Demonstrates how to perform AEAD operations (AES-CCM, AES-GCM, ChaCha20-Poly1305) using the PSA Crypto API, with hardware acceleration on Secure Vault devices.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Advanced"]
source:
  - path: app_init.c
  - path: app_process.c
  - path: app_psa_crypto_aead.c
  - path: app_psa_crypto_key.c
include:
  - path: .
    file_list:
    - path: app_init.h
    - path: app_process.h
    - path: app_psa_crypto_aead.h
    - path: app_psa_crypto_key.h
    - path: app_psa_crypto_macro.h
readme:
  - path: readme.md
ui_hints:
  highlight:
    - path: readme.md
      focus: true
component:
  - id: psa_crypto_ccm
  - id: psa_crypto_gcm
  - id: psa_crypto_chachapoly
  - id: psa_crypto_sha256
  - id: psa_its
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: printf
  - id: iostream_retarget_stdio
  - id: iostream_recommended_stream
configuration:
  - name: SL_CLOCK_MANAGER_HFRCO_BAND
    value: 38000000
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
define:
  - name: DEBUG_EFM
  - name: PSA_CRYPTO_PRINT
toolchain_settings:
  - option: optimize
    value: debug
