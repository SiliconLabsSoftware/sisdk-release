id: se_manager_mailbox
label: SE mailbox utilities
package: platform_core
description: >-
  Provides SE mailbox APIs to be used by the SE Manager
category: Platform|Security|SE Manager
quality: production
ui_hints:
  visibility: never
include:
- path: inc
  file_list:
  - path: sli_se_manager_mailbox.h

requires:
- name: device
- name: cmsis_core
- name: se_manager_mailbox_source

provides:
- name: se_manager_mailbox

recommends:
- id: se_manager_mailbox_default
  vendor: silabs

metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/security/sl_component/se_manager
