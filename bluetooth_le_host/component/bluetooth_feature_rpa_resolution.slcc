id: "bluetooth_feature_rpa_resolution"
label: "RPA Resolution"
package: bluetooth_le_host
description: >
  Bluetooth LE Resolvable Private Address (RPA) resolution feature. Enables
  resolving RPAs of peer devices using their Identity Resolving Key (IRK).
  This feature requires the Bonding Database component for IRK management.
category: Bluetooth|Bluetooth Host (Stack)|Additional Features
quality: "production"
requires:
- name: "bluetooth_stack"
- name: "bluetooth_feature_bonding_database"
- name: "bluetooth_crypto"
- name: "bluetooth_crypto_lib"
provides:
- name: "bluetooth_feature_rpa_resolution"
template_contribution:
- name: component_catalog
  value: bluetooth_feature_rpa_resolution
documentation:
  docset: bluetooth
  document: bluetooth-stack-api/sl-bt-gap
metadata:
  sbom:
    license: MSLA
library:
- path: build/gcc/cortex-m33/privacy/rpa_resolution/release/libble_host_rpa_resolution.a
  condition:
  - toolchain_gcc
  - cortexm33
  - bluetooth_host_release_libraries
- path: build/gcc/cortex-m55/privacy/rpa_resolution/release/libble_host_rpa_resolution.a
  condition:
  - toolchain_gcc
  - cortexm55
  - bluetooth_host_release_libraries
- path: build/iar/cortex-m33/privacy/rpa_resolution/release/libble_host_rpa_resolution.a
  condition:
  - toolchain_iar
  - cortexm33
  - bluetooth_host_release_libraries
- path: build/iar/cortex-m55/privacy/rpa_resolution/release/libble_host_rpa_resolution.a
  condition:
  - toolchain_iar
  - cortexm55
  - bluetooth_host_release_libraries
- path: build/llvm/cortex-m33/privacy/rpa_resolution/release/libble_host_rpa_resolution.a
  condition:
  - toolchain_llvm
  - cortexm33
  - bluetooth_host_release_libraries
- path: build/llvm/cortex-m55/privacy/rpa_resolution/release/libble_host_rpa_resolution.a
  condition:
  - toolchain_llvm
  - cortexm55
  - bluetooth_host_release_libraries
root_path: bluetooth_le_host
