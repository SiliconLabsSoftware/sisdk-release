id: "bluetooth_host_release_libraries"
label: "Bluetooth Low Energy Host Library"
ui_hints:
  visibility: never
package: bluetooth_le_host
description: >
  BLE host libraries to be used by the Bluetooth stack
category: Bluetooth|Bluetooth Host (Stack)
quality: "production"
requires:
- name: "bluetooth_common"
provides:
- name: "bluetooth_host_libraries"
- name: "bluetooth_host_release_libraries"
library:
- path: build/gcc/cortex-m33/accept_list/release/libble_host_accept_list.a
  condition:
  - toolchain_gcc
  - cortexm33
  - bluetooth_feature_accept_list
- path: build/gcc/cortex-m33/accept_list/release/libble_host_accept_list_stub.a
  condition:
  - toolchain_gcc
  - cortexm33
  unless:
  - bluetooth_feature_accept_list
- path: build/gcc/cortex-m33/advertiser/pawr_advertiser/release/libble_host_pawr_advertiser.a
  condition:
  - toolchain_gcc
  - cortexm33
  - bluetooth_feature_pawr_advertiser
- path: build/gcc/cortex-m33/advertiser/periodic_advertiser/release/libble_host_periodic_advertiser.a
  condition:
  - toolchain_gcc
  - cortexm33
  - bluetooth_feature_periodic_advertiser
- path: build/gcc/cortex-m33/advertiser/periodic_advertiser/release/libble_host_periodic_advertiser_stub.a
  condition:
  - toolchain_gcc
  - cortexm33
  unless:
  - bluetooth_feature_periodic_advertiser
- path: build/gcc/cortex-m33/bgstack/release/libble_host.a
  condition:
  - toolchain_gcc
  - cortexm33
- path: build/gcc/cortex-m33/bgstack/release/libbondingdb_stub.a
  condition:
  - toolchain_gcc
  - cortexm33
  unless:
  - bluetooth_feature_builtin_bonding_database
- path: build/gcc/cortex-m33/ble_bgapi/release/libble_bgapi.a
  condition:
  - toolchain_gcc
  - cortexm33
- path: build/gcc/cortex-m33/ble_bgapi/release/libble_bgapi_stub_gatt_client.a
  condition:
  - toolchain_gcc
  - cortexm33
  unless:
  - bluetooth_feature_gatt
- path: build/gcc/cortex-m33/ble_bgapi/release/libble_bgapi_stub_gatt_server.a
  condition:
  - toolchain_gcc
  - cortexm33
  unless:
  - bluetooth_feature_gatt_server
- path: build/gcc/cortex-m33/ble_system/release/libble_system.a
  condition:
  - toolchain_gcc
  - cortexm33
- path: build/gcc/cortex-m33/channel_classification/release/libble_host_channel_classification.a
  condition:
  - toolchain_gcc
  - cortexm33
  - bluetooth_feature_channel_classification
- path: build/gcc/cortex-m33/channel_sounding/channel_sounding_test/release/libble_host_channel_sounding_test.a
