id: mbedtls_ssl_proto_dtls
package: platform_core
label: DTLS Protocol
description: >-
  This component provides support for the DTLS protocol using Mbed TLS.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_ssl_proto_dtls
  allow_multiple: true
requires:
- name: mbedtls_ssl_proto_tls12
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_SSL_PROTO_DTLS
documentation:
  url: https://mbed-tls.readthedocs.io/projects/api/en/development/api/file/mbedtls__config_8h/#c.MBEDTLS_SSL_PROTO_DTLS
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
