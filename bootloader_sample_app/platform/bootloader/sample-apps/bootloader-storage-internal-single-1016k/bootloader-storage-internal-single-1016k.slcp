project_name: bootloader-storage-internal-single-1016k
package: bootloader
quality: production
label: Bootloader - SoC Internal Storage (single image on 1016kB device)
description: >
   Demonstrates how to configure the Gecko Bootloader to store firmware update images using internal main flash, in a single-slot 1016 kB layout with Slot0 at 0x78000 sized 488 kB.

category: Example|Bootloader
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]
  - name: "MCU"
    value: ["Bootloader"]


component:
  - id: bootloader_core
  - id: bootloader_crc
  - id: bootloader_aes_sha_ecdsa
  - id: bootloader_internal_storage
  - id: bootloader_storage_slots
  - id: bootloader_image_parser
  - id: bootloader_common_storage_single
  - id: bootloader_token_management
  - id: bootloader_debug

configuration:
  - name: SLOT0_ENABLE
    value: 1
  - name: SLOT0_SIZE
    value: 499712
  ## device_sdid_250 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 134709248
    condition: [device_sdid_250]
  - name: SLOT0_START
    value: 134709248
    condition: [device_sdid_250]

tag:
  - hardware:device:flash:1016

readme:
  - path: readme.md
ui_hints:
  highlight: readme.md

post_build:
  profile: bootloader_series_2
