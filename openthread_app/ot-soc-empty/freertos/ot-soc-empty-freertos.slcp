project_name: ot-soc-empty-freertos
label: OpenThread - SoC Empty FTD FreeRTOS
package: openthread
description: >
  Demonstrates OpenThread SoC application on a Full Thread Device (FTD) using FreeRTOS, intended as a base for developing Thread applications.
category: OpenThread Examples
quality: production

component:
  - id: freertos
  - id: sl_main
  - id: ot_stack_ftd
  - id: clock_manager
  - id: rail_util_pti
  - id: bootloader_interface
  # Platform - Enable LTO for gcc and llvm by installing the following component
  - id: toolchain_gcc_lto
    condition: [toolchain_gcc]
  - id: toolchain_llvm_lto
    condition: [toolchain_llvm]
  - id: ot_default_dataset_values

include:
  - path: .
    file_list:
      - path: app.h

source:
  - path: app.c

configuration:
  - name: SL_HEAP_SIZE
    value: 16384
  # This stack size is dependent on LTO optimization. In the cases, where LTO merges more than 1 functions in a single one
  # (includes inlining) causing the stack to increase. This project wide configuration, it is recommended to ensure this
  # configuration is updated with appropriate values based on the additional components installed and application code added.
  - name: SL_STACK_SIZE
    value: 4608
    unless: [toolchain_lto]
  - name: SL_STACK_SIZE
    value: 5120
    condition: [toolchain_lto]
  # Stack size config end
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 4608
    condition: [sl_main]
  - name: OPENTHREAD_CONFIG_LOG_OUTPUT
    value: OPENTHREAD_CONFIG_LOG_OUTPUT_NONE
  - name: CIRCULAR_QUEUE_LEN_MAX
    value: 16
  - name: SL_OPENTHREAD_STACK_TASK_MEM_SIZE
    value: 7168
    condition: [toolchain_lto]
  - name: configTOTAL_HEAP_SIZE
    value: 16384
    condition: [toolchain_lto]

tag:
  - hwfilter:device:device_supports_thread
  - hwfilter:!device:device_family_efr32mr21
  - toolchain:gcc
  - toolchain:llvm
readme:
  - path: ./README.md

filter:
  - name: "Wireless Technology"
    value: ["Thread"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Beginner"]

ui_hints:
  highlight:
    - path: ./README.md
      focus: true