project_name: zigbee_ncp_cpc_spi
label: Zigbee - NCP CPC over SPI
package: zigbee
category: Zigbee Application
quality: production
description: NCP using Co-Processor Communication (CPC) over SPI. Host connects via CPC daemon to EFR. Extensible for init, events, and messaging.
author: Silicon Laboratories, Inc.

component:
  - id: sl_main
  - id: cpc_secondary_recommended_spi_interface
  - id: zigbee_debug_print
  - id: zigbee_debug_basic
  - id: zigbee_debug_extended
  - id: zigbee_gp
  - id: zigbee_ncp_cpc
  - id: zigbee_pro_stack
  - id: zigbee_source_route
  - id: zigbee_security_link_keys
  - id: zigbee_r22_support
  - id: zigbee_zll
  - id: clock_manager
  # Platform - enable LTO for gcc and llvm
  - id: toolchain_gcc_lto
    condition:
      - toolchain_gcc
  - id: toolchain_llvm_lto
    condition:
      - toolchain_llvm

configuration:
  - name: SL_ZIGBEE_BINDING_TABLE_SIZE
    value: 32
  - name: SL_ZIGBEE_MAX_END_DEVICE_CHILDREN
    value: 32
  - name: SL_ZIGBEE_PACKET_BUFFER_HEAP_SIZE
    value: SL_ZIGBEE_LARGE_PACKET_BUFFER_HEAP
  - name: SL_CPC_RX_BUFFER_MAX_COUNT
    value: 10
  - name: SL_CPC_TX_QUEUE_ITEM_MAX_COUNT
    value: 10
  - name: SL_ZIGBEE_CHILD_TABLE_SIZE
    value: 32
  - name: SL_ZIGBEE_KEY_TABLE_SIZE
    value: 12
  - name: SL_ZIGBEE_OS_STACK_TASK_PRIORITY
    value: osPriorityNormal1
  - name: NVM3_DEFAULT_CACHE_SIZE
    value: 600
  - name: NVM3_DEFAULT_NVM_SIZE
    value: 32768
    condition:
      - device_series_2
  - name: SL_STACK_SIZE
    value: 3584
    condition:
      - micriumos_kernel
  - name: SL_STACK_SIZE
    value: 4096
    condition:
      - freertos
  # If using zigbee_secure_key_storage we do not need to support backwards
  # compatibility because we have never deployed images with keys in PSA
  # As a result, these lines end up saving some code space
  - name: SL_PSA_ITS_SUPPORT_V1_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V2_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V3_DRIVER
    value: 1
define:
  - name: SL_ZIGBEE_CUSTOM_MAC_FILTER_TABLE_SIZE
    value: 15
include:
  - path: ./

source:
  - path: main.c
    unless: [cmsis_rtos2]
  - path: app.c

readme:
  - path: ./readme.md

ui_hints:
  highlight:
    - path: readme.md
      focus: false

filter:
  - name: Wireless Technology
    value: [Zigbee]
  - name: Device Type
    value: [NCP]
  - name: Project Difficulty
    value: [Advanced]

tag:
  - hardware:component:exp_header:spi
  - hwfilter:ram:64k
  - hwfilter:device:device_supports_zigbee
  - hwfilter:!board:zb_boards_spi_incompatible
  - hwfilter:!board:zb_boards_ncp_spi_incompatible
  - hwfilter:!board:zb_boards_no_spi_eusart_config
  - hwfilter:board:hardware_board_has_spi
  - toolchain:gcc
  - toolchain:iar
  - toolchain:llvm
