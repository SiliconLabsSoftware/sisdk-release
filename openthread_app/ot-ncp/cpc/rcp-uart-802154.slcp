project_name: rcp-uart-802154
label: OpenThread Zigbee CMP - RCP UART
package: openthread
description: >
  Demonstrates Multiprotocol Radio Co-Processor (RCP) running OpenThread and Zigbee concurrently using CMP/multi-PAN on a shared 802.15.4 channel. Host communicates via CPC over UART.
category: OpenThread Examples
quality: production

component:
  - id: sl_main
  - id: ot_crash_handler
  - id: ot_stack_rcp
  - id: ot_ncp_cpc
  - id: cpc_secondary_driver_uart_usart
    instance: [vcom]
    condition: [device_series_2]
  - id: cpc_secondary_driver_uart_eusart
    instance: [vcom]
    condition: [device_series_3]
  - id: rail_util_pti
  - id: bootloader_interface
  - id: ot_gp_interface
  - id: clock_manager
  - id: ot_diags
  - id: ot_reset_utils
  # Platform - Enable LTO for gcc and llvm by installing the following component
  - id: toolchain_gcc_lto
    condition: [toolchain_gcc]
  - id: toolchain_llvm_lto
    condition: [toolchain_llvm]

include:
  - path: .
    file_list:
      - path: app.h

source:
  - path: app.c

configuration:
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 2752
    condition: [sl_main]
  - name: SL_STACK_SIZE
    value: 2752
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_CPC_DRV_UART_VCOM_BAUDRATE
    value: 115200
  - name: SL_CPC_DRV_UART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlCtsAndRts
    condition: [cpc_secondary_driver_uart_usart]
  - name: SL_CPC_DRV_UART_VCOM_FLOW_CONTROL_TYPE
    value: eusartHwFlowControlCtsAndRts
    condition: [cpc_secondary_driver_uart_eusart]
  - name: OPENTHREAD_CONFIG_HEAP_EXTERNAL_ENABLE
    value: 0
  - name: OPENTHREAD_CONFIG_LOG_OUTPUT
    value: OPENTHREAD_CONFIG_LOG_OUTPUT_NONE
  - name: OPENTHREAD_CONFIG_MULTIPAN_RCP_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_MULTIPLE_INSTANCE_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_MULTIPLE_STATIC_INSTANCE_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_LOG_INSTANCE_AWARE_API_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_MAC_CSL_RECEIVER_ENABLE
    value: 0
  - name: OPENTHREAD_CONFIG_MAC_CSL_AUTO_SYNC_ENABLE
    value: 0
  - name: SL_CPC_RX_BUFFER_MAX_COUNT
    value: 15
  - name: SL_CPC_TX_QUEUE_ITEM_MAX_COUNT
    value: 15
  - name: CIRCULAR_QUEUE_LEN_MAX
    value: 16
  - name: SL_OPENTHREAD_STACK_TASK_MEM_SIZE
    value: 4608

tag:
  - prebuilt_demo
  - hwfilter:device:device_supports_thread
  - toolchain:gcc
  - toolchain:llvm

readme:
  - path: ./README-MP-RCP.md

filter:
  - name: "Wireless Technology"
    value: ["Thread", "Zigbee"]
  - name: "Device Type"
    value: ["RCP"]
  - name: "Capability"
    value: ["Multiprotocol"]
  - name: "Project Difficulty"
    value: ["Advanced"]

ui_hints:
  highlight:
    - path: ./README-MP-RCP.md
      focus: true
