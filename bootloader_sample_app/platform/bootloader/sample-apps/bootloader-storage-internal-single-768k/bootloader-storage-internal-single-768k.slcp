    value: 134594560
    condition: [device_sdid_220]
  - name: SLOT0_START
    value: 134594560
    condition: [device_sdid_220]
  ## device_sdid_230 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 134594560
    condition: [device_sdid_230]
  - name: SLOT0_START
    value: 134594560
    condition: [device_sdid_230]
  ## device_sdid_225 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 134594560
    condition: [device_sdid_225]
  - name: SLOT0_START
    value: 134594560
    condition: [device_sdid_225]
  ## device_sdid_235 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 134594560
    condition: [device_sdid_235]
  - name: SLOT0_START
    value: 134594560
    condition: [device_sdid_235]
  ## device_sdid_240 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 134594560
    condition: [device_sdid_240]
  - name: SLOT0_START
    value: 134594560
