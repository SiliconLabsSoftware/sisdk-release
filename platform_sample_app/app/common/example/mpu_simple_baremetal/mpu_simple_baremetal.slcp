project_name: mpu_simple_baremetal
package: platform
quality: production
label: Platform - MPU Simple
description: >
  Shows how the Memory Protection Unit (MPU) blocks code execution from RAM to prevent code injection attacks. Demonstrates enable/disable behavior.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: app.c
  - path: mpu_simple_app.c
include:
  - path: .
    file_list:
    - path: app.h
    - path: mpu_simple_app.h
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: mpu
  - id: iostream_retarget_stdio
  - id: iostream_recommended_stream
  - id: code_classification
configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
define:
  - name: DEBUG_EFM
readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
tag:
  - hardware:component:mpu
  - hwfilter:device:device_has_mpu
  - hwfilter:device:device_series_2
