id: nvm3_trace_config
label: NVM3 Trace Config
package: platform_core
description: >
  NVM3 trace configuration and trace macros shared across NVM3 components.
category: Services|NVM3
quality: production
metadata:
  sbom:
    license: Zlib
include:
- path: platform/emdrv/nvm3/inc
  file_list:
  - path: nvm3_trace.h
- path: platform/emdrv/nvm3/config
  file_list:
  - path: nvm3_config.h
provides:
- name: nvm3_trace_config
root_path: platform_core
