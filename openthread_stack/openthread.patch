+void PeerDiscoverer::ResetPeerResolveState(Peer &aPeer)
+{
+    // Stop host resolver before service resolvers clear `mHostName`.
+    StopHostAddressResolver(aPeer);
+    StopServiceResolvers(aPeer);
+
+    aPeer.mTxtDataValidated = false;
+    aPeer.mPort             = 0;
