id: mbedtls_adjust_config
package: mbedtls
label: Mbed TLS Config Adjust Headers
description: >-
  Shared Mbed TLS build-info and config-adjust headers required by
  `mbedtls/build_info.h` and `mbedtls/config_psa.h` include chains across
  TrustZone Secure, TrustZone Unaware, and TrustZone Non-Secure builds.
category: Platform|Security|Mbed TLS
quality: production
ui_hints:
  visibility: never
provides:
- name: mbedtls_adjust_config
requires:
- name: psa_crypto_adjust_config
include:
- path: include
  file_list:
  - path: mbedtls/build_info.h
  - path: mbedtls/check_config.h
  - path: mbedtls/config_adjust_legacy_crypto.h
  - path: mbedtls/config_adjust_legacy_from_psa.h
  - path: mbedtls/config_adjust_psa_from_legacy.h
  - path: mbedtls/config_adjust_psa_superset_legacy.h
  - path: mbedtls/config_adjust_ssl.h
  - path: mbedtls/config_adjust_x509.h
  - path: mbedtls/config_psa.h
  - path: mbedtls/mbedtls_config.h

metadata:
  sbom:
    reference: mbedtls_sbom
root_path: mbedtls
