id: memory_manager_cpp
label: Memory Manager C++ Support
package: platform_core
description: >
  This component adds C++ support to the Memory Manager.
  The C++ new/delete constructs are globally overloaded. New and delete respectively call the
  Memory Manager sl_memory_alloc() and sl_memory_free() functions.
  Hence, any C++ Simplicity SDK stacks such as OpenThread, Matter, AoX RTLLib doing dynamic memory allocations
  via the classic C++ new/delete or any standard containers will call under the hood the Memory Manager API.
category: Services|Memory Manager
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/service/memory_manager
source:
- path: src/sl_memory_manager_cpp.cpp
provides:
- name: memory_manager_cpp
requires:
- name: memory_manager
- name: cpp_support
toolchain_settings:
  # Force the global C++ operator new symbols defined in sl_memory_manager_cpp.cpp
  # to stay linked so the weak libc/libc++ implementations are not selected. Without this,
  # the array, nothrow and aligned new overloads can be resolved internally by libc
  # (notably with LLVM/libc++), bypassing the Memory Manager. The names are the
  # Itanium C++ ABI mangled symbols for ILP32 ARM (size_t == unsigned int == 'j'):
  #   _Znwj                               operator new(size_t)
  #   _Znaj                               operator new[](size_t)
  #   _ZnwjRKSt9nothrow_t                 operator new(size_t, nothrow_t const&)
  #   _ZnajRKSt9nothrow_t                 operator new[](size_t, nothrow_t const&)
  #   _ZnwjSt11align_val_t                operator new(size_t, align_val_t)
  #   _ZnajSt11align_val_t                operator new[](size_t, align_val_t)
  #   _ZnwjSt11align_val_tRKSt9nothrow_t  operator new(size_t, align_val_t, nothrow_t const&)
  #   _ZnajSt11align_val_tRKSt9nothrow_t  operator new[](size_t, align_val_t, nothrow_t const&)
- option: gcc_linker_option
  value: -Wl,--undefined=_Znwj -Wl,--undefined=_Znaj -Wl,--undefined=_ZnwjRKSt9nothrow_t -Wl,--undefined=_ZnajRKSt9nothrow_t -Wl,--undefined=_ZnwjSt11align_val_t -Wl,--undefined=_ZnajSt11align_val_t -Wl,--undefined=_ZnwjSt11align_val_tRKSt9nothrow_t -Wl,--undefined=_ZnajSt11align_val_tRKSt9nothrow_t
- option: llvm_linker_option
  value: -Wl,--undefined=_Znwj -Wl,--undefined=_Znaj -Wl,--undefined=_ZnwjRKSt9nothrow_t -Wl,--undefined=_ZnajRKSt9nothrow_t -Wl,--undefined=_ZnwjSt11align_val_t -Wl,--undefined=_ZnajSt11align_val_t -Wl,--undefined=_ZnwjSt11align_val_tRKSt9nothrow_t -Wl,--undefined=_ZnajSt11align_val_tRKSt9nothrow_t
