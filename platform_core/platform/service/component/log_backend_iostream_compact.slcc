id: log_backend_iostream_compact
label: Log Backend I/O Stream – Compact Binary Output
package: platform_core
description: >
  Compact binary output for the I/O Stream log backend. Events are written as
  raw sl_log_event_t structs, preserving the ring-buffer layout with wrap-around
  handling. This format minimizes on-wire overhead and is intended for offline
  parsing by host-side tooling. Requires the log_backend_iostream component
  for transport.
category: Services|Log
quality: evaluation
metadata:
  sbom:
    license: Zlib
provides:
- name: log_backend
- name: log_backend_iostream_impl
- name: log_backend_iostream_compact
  condition: [device_si91x]
requires:
- name: iostream_recommended_console
- name: log
- name: log_platform_core
- name: log_backend_iostream
root_path: platform_core/platform/service/sl_log
config_file:
- path: config/sl_log_proprietary_config.h
  unless: [device_si91x]
- path: config/sl_log_common_config.h
  unless: [device_si91x]
- path: config/sl_log_platform_core_config.h
  condition: [device_has_timer]
source:
- path: backend/iostream/src/sl_log_backend_iostream_compact.c
template_contribution:
- name: component_catalog
  value: log_backend_proprietary
  unless: [device_si91x]
- name: log_section_enable
  value: 1
- name: log_compact_output_enable
  value: 1
