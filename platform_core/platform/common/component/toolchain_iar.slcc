id: toolchain_iar
label: IAR Toolchain
package: platform_core
description: Toolchain support for IAR
category: Platform|Toolchain
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/common
tag:
- toolchain:id:iar
provides:
- name: toolchain
- name: toolchain_iar
- name: toolchain_supports_arm
  # IAR does not support LTO. This provider is intentionally a no-op and only
  # exists to avoid generation failures when an application requires
  # toolchain_lto while being generated with the IAR toolchain.
- name: toolchain_lto
  allow_multiple: true
requires:
- name: toolchain_linker_type
- name: toolchain_variant
  condition: [device_arm]
- name: memory_manager_region
  condition: [device_cortexm]
recommends:
- id: toolchain_iar_standard
  vendor: silabs
