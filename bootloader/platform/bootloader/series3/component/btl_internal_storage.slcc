id: btl_internal_storage
label: Internal Storage (Series-3)
package: bootloader
description: >
  The Bootloader Internal Storage is a storage component using
  internal flash. With this component included, during upgrade image is stored
  in the internal flash during the upgrade process. DMA channel can be
  configured for DMA-based MSC write.
category: Platform|Bootloader|Storage
quality: production
source:
- path: platform/bootloader/series3/storage/ext_mem/btl_storage_ext_mem.c
include:
- path: platform/bootloader/series3/storage/ext_mem
  file_list:
  - path: btl_storage_ext_mem.h
define:
- name: BOOTLOADER_SUPPORT_STORAGE
  value: 1
provides:
- name: btl_internal_storage
requires:
- name: bootloader_interface_s3
config_file:
- path: platform/bootloader/series3/config/internal_storage_slot_cfg/btl_storage_slot_cfg_default.h
  override:
    component: btl_storage_slots
    file_id: btl_storage_slot_cfg_default
    vendor: silabs
  unless: [btl_storage_slot_cfg_default_override]
template_file:
- path: platform/bootloader/series3/config/internal_storage_slot_cfg/btl_internal_storage_slot_cfg_default.h.jinja
  unless: [btl_storage_slot_cfg_default_override]
metadata:
  sbom:
    license: MSLA
root_path: bootloader
