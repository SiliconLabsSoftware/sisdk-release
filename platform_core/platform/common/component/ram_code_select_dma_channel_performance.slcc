id: ram_code_select_dma_channel_performance
label: RAM Code for DMA Channel Performance
package: platform_core
description: >
  For devices with external FLASH, locates DMA channel interrupt handlers and associated code in RAM rather than FLASH.
  Reduces interrupt latency by avoiding FLASH cache misses at the cost of higher RAM consumption.
category: Platform|Toolchain
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: ram_code_select_dma_channel_performance
requires:
- name: code_classification
template_contribution:
- name: code_classification_standard_selections
  value: dmachannelperf
  condition: [device_series_3]
root_path: platform_core
