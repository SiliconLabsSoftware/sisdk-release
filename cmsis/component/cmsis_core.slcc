id: cmsis_core
label: CMSIS-Core
package: cmsis
description: CMSIS core include path.
category: Platform|CMSIS
quality: production
metadata:
  sbom:
    license: Apache 2.0
    upstream:
      name: CMSIS_6
      version: 6.2.0
      supplier: ARM-software
      url: https://github.com/ARM-software/CMSIS_6
      package_url: pkg:github/ARM-software/CMSIS_6@6.2.0
      comment: The CMSIS is a set of tools, APIs, frameworks, and work flows
include:
- path: Core/Include
  file_list:
  - path: sli_cmsis_deprecated_aliases.h
  - path: cmsis_compiler.h
  - path: cmsis_version.h
  - path: tz_context.h
  - path: cmsis_armclang.h
    condition:
    - toolchain_armclang
  - path: cmsis_clang.h
    condition:
    - toolchain_llvm
  - path: cmsis_gcc.h
    condition:
    - toolchain_gcc
  - path: cmsis_iccarm.h
    condition:
    - toolchain_iar
  - path: core_cm0.h
    condition:
    - cortexm0
  - path: core_cm0plus.h
    condition:
    - cortexm0plus
  - path: core_cm1.h
    condition:
    - cortexm1
  - path: core_cm3.h
    condition:
    - cortexm3
  - path: core_cm4.h
    condition:
    - cortexm4
  - path: core_cm7.h
    condition:
    - cortexm7
  - path: core_cm23.h
    condition:
    - cortexm23
  - path: core_cm33.h
    condition:
    - cortexm33
  - path: core_cm35p.h
    condition:
    - cortexm35p
  - path: core_cm52.h
    condition:
    - cortexm52
  - path: core_cm55.h
    condition:
    - cortexm55
  - path: core_sc000.h
    condition:
    - securcore000
  - path: core_sc300.h
    condition:
    - securcore300
- path: Core/Include/m-profile
  file_list:
  - path: cmsis_armclang_m.h
    condition:
    - toolchain_armclang
  - path: cmsis_clang_m.h
    condition:
    - toolchain_llvm
  - path: cmsis_gcc_m.h
    condition:
    - toolchain_gcc
  - path: cmsis_iccarm_m.h
    condition:
    - toolchain_iar
  - path: armv7m_mpu.h
    condition:
    - device_has_mpu
    - cortexm0
  - path: armv7m_mpu.h
    condition:
    - device_has_mpu
    - cortexm0plus
  - path: armv7m_mpu.h
    condition:
    - device_has_mpu
    - cortexm3
  - path: armv7m_mpu.h
    condition:
    - device_has_mpu
    - cortexm4
  - path: armv7m_mpu.h
    condition:
    - device_has_mpu
    - cortexm7
  - path: armv8m_mpu.h
    condition:
    - device_has_mpu
    - cortexm23
  - path: armv8m_mpu.h
    condition:
    - device_has_mpu
    - cortexm33
  - path: armv8m_mpu.h
    condition:
    - device_has_mpu
    - cortexm55
  - path: armv8m_pmu.h
    condition:
    - device_has_pmu
    - cortexm23
  - path: armv8m_pmu.h
    condition:
    - device_has_pmu
    - cortexm33
  - path: armv8m_pmu.h
    condition:
    - device_has_pmu
    - cortexm55
- path: Core/Include/a-profile
  file_list:
  - path: cmsis_armclang_a.h
    condition:
    - toolchain_armclang
    - simulation
    - macos
  - path: cmsis_clang_a.h
    condition:
    - toolchain_llvm
    - simulation
    - macos
  - path: cmsis_gcc_a.h
    condition:
    - toolchain_gcc
    - simulation
    - macos
  - path: cmsis_iccarm_a.h
    condition:
    - toolchain_iar
    - simulation
    - macos
  - path: cmsis_cp15.h
    condition:
    - simulation
    - macos
  - path: irq_ctrl.h
    condition:
    - simulation
    - macos
provides:
- name: cmsis_core
template_file:
- path: template/RTE_Components.h.jinja
root_path: cmsis
