id: mbedtls_crypto_platform_api
package: mbedtls
label: Mbed TLS Crypto Platform API
description: >-
  Public Mbed TLS crypto and platform header files required by the PSA Crypto API.
category: Platform|Security|Mbed TLS
quality: production
ui_hints:
  visibility: never
provides:
- name: mbedtls_crypto_platform_api
requires:
- name: mbedtls_adjust_config
include:
- path: include
  file_list:
  - path: mbedtls/aes.h
  - path: mbedtls/aria.h
  - path: mbedtls/bignum.h
  - path: mbedtls/block_cipher.h
  - path: mbedtls/camellia.h
  - path: mbedtls/ccm.h
  - path: mbedtls/cipher.h
  - path: mbedtls/ecdsa.h
  - path: mbedtls/ecjpake.h
  - path: mbedtls/ecp.h
  - path: mbedtls/md.h
  - path: mbedtls/md5.h
  - path: mbedtls/nist_kw.h
  - path: mbedtls/platform_time.h
  - path: mbedtls/platform_util.h
  - path: mbedtls/pk.h
  - path: mbedtls/private_access.h
  - path: mbedtls/psa_util.h
  - path: mbedtls/ripemd160.h
  - path: mbedtls/sha1.h
  - path: mbedtls/sha256.h
  - path: mbedtls/sha3.h
  - path: mbedtls/sha512.h
  - path: mbedtls/ssl.h
  - path: mbedtls/ssl_cookie.h
  - path: mbedtls/x509.h
  - path: mbedtls/x509_crt.h
  - path: mbedtls/chacha20.h
  - path: mbedtls/chachapoly.h
  - path: mbedtls/cmac.h
  - path: mbedtls/gcm.h
  - path: mbedtls/poly1305.h

metadata:
  sbom:
    reference: mbedtls_sbom
root_path: mbedtls
