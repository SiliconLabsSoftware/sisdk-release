project_name: se_manager_user_data
package: platform
quality: production
label: Platform Security - SoC SE Manager User Data
description: >
  Demonstrates how to erase and write the SE user data region and verify the contents using SE Manager user data APIs on supported Series 2 devices.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Advanced"]
source:
  - path: app_init.c
  - path: app_process.c
  - path: app_se_manager_user_data.c
include:
  - path: .
    file_list:
    - path: app_init.h
    - path: app_process.h
    - path: app_se_manager_macro.h
    - path: app_se_manager_user_data.h
readme:
  - path: readme.md
ui_hints:
  highlight:
    - path: readme.md
      focus: true
component:
  - id: sl_string
  - id: status_string
  - id: se_manager
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: printf
  - id: iostream_retarget_stdio
  - id: iostream_recommended_stream
  - id: toolchain_llvm_lto
    condition: [toolchain_llvm]
requires:
  - name: device_sdid_200
configuration:
  - name: SL_STATUS_STRING_ENABLE_BLUETOOTH
    value: 0
  - name: SL_STATUS_STRING_ENABLE_WIFI
    value: 0
  - name: SL_CLOCK_MANAGER_HFRCO_BAND
    value: 38000000
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
define:
  - name: DEBUG_EFM
  - name: SE_MANAGER_PRINT
toolchain_settings:
  - option: optimize
    value: size