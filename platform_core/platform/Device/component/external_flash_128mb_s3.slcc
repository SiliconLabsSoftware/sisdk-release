id: external_flash_128mb_s3
label: 128 MB External Flash
package: platform_core
description: >
  Configures 128 MB of external flash for the device.
category: Platform|Device|Flash
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: external_flash_128mb_s3
- name: external_flash_size_s3
- name: device_has_130880kb_flash
  condition:
  - device_se_size_192k
- name: device_has_130816kb_flash
  condition:
  - device_se_size_256k
requires:
- name: device_efx
- name: device_has_ext_mem
template_contribution:
- name: device_flash_size
  value: 134021120
  condition:
  - device_se_size_192k
- name: device_flash_size
  value: 133955584
  condition:
  - device_se_size_256k
- name: device_flash_mspu_region_size
  value: 1048576
  condition:
  - device_generic_family_sixx301
root_path: platform_core
