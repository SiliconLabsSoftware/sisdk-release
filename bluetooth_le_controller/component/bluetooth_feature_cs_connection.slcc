id: "bluetooth_feature_cs_connection"
label: "Connection based Channel Sounding"
package: bluetooth_le_controller
description: >
  This component, corresponding to the "cs" class in Bluetooth APIs,
  provides the connection based Channel Sounding feature.
category: Bluetooth|Bluetooth LE Controller (Link Layer)|Features with Commands and Events
quality: "production"
requires:
- name: "bluetooth_controller"
- name: "bluetooth_feature_connection"
- name: "bluetooth_feature_cs"
- name: "device_supports_bluetooth_cs"
provides:
- name: "bluetooth_feature_cs_connection"
- name: "bluetooth_feature_cs_link"
ui_hints:
  visibility: never
metadata:
  sbom:
    license: Zlib AND MSLA

root_path: bluetooth_le_controller
