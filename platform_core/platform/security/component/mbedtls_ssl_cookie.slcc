id: mbedtls_ssl_cookie
package: platform_core
label: DTLS Cookie
description: >-
  This component enables support for DTLS cookies for hello verification.
category: Platform|Security|Mbed TLS|Upper Layer
quality: production
provides:
- name: mbedtls_ssl_cookie
requires:
  # requires MBEDTLS_USE_PSA_CRYPTO ( in psa_crypto )
- name: psa_crypto
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_SSL_COOKIE_C
documentation:
  url: https://mbed-tls.readthedocs.io/projects/api/en/development/api/file/mbedtls__config_8h/#c.MBEDTLS_SSL_COOKIE_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: platform_core
