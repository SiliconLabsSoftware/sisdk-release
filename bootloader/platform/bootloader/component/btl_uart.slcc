id: btl_uart
label: Bootloader UART Extension Component
package: bootloader
description: >
  Extension component providing UART functionality for bootloader.
category: Platform|Bootloader|Utils
quality: production
source:
- path: "platform/bootloader/driver/btl_driver_util.c"
include:
- path: "platform/bootloader/config/device_series_2"
  file_list:
  - path: "btl_core_cfg.h"
- path: platform/bootloader/driver
  file_list:
  - path: btl_driver_util.h
- path: platform/bootloader
  file_list:
  - path: core/btl_core.h
  - path: core/btl_bootload.h
  - path: core/btl_parse.h
  - path: config/btl_config.h
- path: platform/bootloader/core
  file_list:
  - path: btl_reset.h
requires:
- name: bootloader_interface_common
provides:
- name: btl_uart
metadata:
  sbom:
    license: MSLA
ui_hints:
  visibility: never
root_path: bootloader
