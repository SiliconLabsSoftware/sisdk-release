id: psa_hostcrypto_driver
package: platform_core
label: PSA HostCrypto Driver Source Code
description: >-
  This component includes the Silicon Labs PSA HostCrypto drivers source code files.
category: Platform|Security|PSA Crypto
quality: production
ui_hints:
  visibility: never
provides:
- name: psa_hostcrypto_driver

requires:
- name: psa_crypto_common
- name: mbedtls_core
- name: sxsymcrypt
- name: sli_crypto_ksu_manager
  condition: [device_has_semailbox, device_has_ksu]

source:
  # Common drivers
- path: src/sli_psa_driver_common.c

- path: src/sli_hostcrypto_transparent_driver_cipher.c
  condition: [device_has_symcrypto]
- path: src/sli_hostcrypto_transparent_driver_aead.c
  condition: [device_has_symcrypto]
- path: src/sli_hostcrypto_transparent_driver_hash.c
  condition: [device_has_symcrypto]
- path: src/sli_hostcrypto_transparent_driver_mac.c
  condition: [device_has_symcrypto]
- path: src/sli_hostcrypto_driver_key_management.c
  condition: [device_has_symcrypto]
- path: src/sli_hostcrypto_opaque_driver.c
  condition: [device_has_symcrypto, device_has_semailbox, device_has_ksu]

include:
- path: inc
  file_list:
  - path: sli_psa_driver_common.h

  - path: sli_hostcrypto_transparent_functions.h
    condition: [device_has_symcrypto]
  - path: sli_hostcrypto_opaque_functions.h
    condition: [device_has_symcrypto, device_has_semailbox, device_has_ksu]
  - path: sli_hostcrypto_transparent_types.h
    condition: [device_has_symcrypto]
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/security/sl_component/sl_psa_driver
