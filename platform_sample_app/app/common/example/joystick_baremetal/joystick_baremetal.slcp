project_name: joystick_baremetal
package: platform
quality: production
label: Platform - Joystick Bare-metal
description: >
  Prints joystick position at intervals over VCOM so you can view it in a terminal. Requires Wireless Pro Kit (BRD4002A) as the mainboard.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: app.c
  - path: app_joystick.c
include:
  - path: .
    file_list:
    - path: app.h
    - path: app_joystick.h
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: joystick
  - id: iostream_retarget_stdio
  - id: iostream_recommended_stream
  - id: sleeptimer
configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
define:
  - name: DEBUG_EFM
readme:
  - path: readme.md
requires:
  - name: brd4002a
ui_hints:
  highlight: readme.md
tag:
  - hardware:component:joystick:skrhaae010
  - hwfilter:board:joystick
  - hwfilter:device:device_series_2
