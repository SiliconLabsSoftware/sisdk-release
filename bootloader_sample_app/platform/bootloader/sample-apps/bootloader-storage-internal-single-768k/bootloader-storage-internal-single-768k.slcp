project_name: bootloader-storage-internal-single-768k
package: bootloader
quality: production
label: Bootloader - SoC Internal Storage (single image on 768kB device)
description: >
   Demonstrates how to configure the Gecko Bootloader to store firmware update images using internal main flash, in a single-slot setup with a 352 kB slot starting at 0x5C000.

category: Example|Bootloader
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]
  - name: "MCU"
    value: ["Bootloader"]


component:
  - id: bootloader_core
  - id: bootloader_crc
  - id: bootloader_aes_sha_ecdsa
  - id: bootloader_internal_storage
  - id: bootloader_storage_slots
  - id: bootloader_image_parser
  - id: bootloader_common_storage
  - id: bootloader_token_management
  - id: bootloader_debug

configuration:
  - name: SLOT0_ENABLE
    value: 1
  - name: SLOT0_SIZE
    value: 360448
  ## device_sdid_200 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 376832
    condition: [device_sdid_200]
  - name: SLOT0_START
    value: 376832
    condition: [device_sdid_200]
  ## device_sdid_205 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 376832
    condition: [device_sdid_205]
  - name: SLOT0_START
    value: 376832
    condition: [device_sdid_205]
  ## device_sdid_210 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 134594560
    condition: [device_sdid_210]
  - name: SLOT0_START
    value: 134594560
    condition: [device_sdid_210]
  ## device_sdid_215 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 134594560
    condition: [device_sdid_215]
  - name: SLOT0_START
    value: 134594560
    condition: [device_sdid_215]
  ## device_sdid_220 ##
