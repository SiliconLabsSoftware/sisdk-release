project_name: bootloader-storage-internal-single-2048k
package: bootloader
quality: production
label: Bootloader - SoC Internal Storage (single image on 2MB device)
description: >
  Demonstrates how to configure the Gecko Bootloader to store firmware update images using internal main flash, in a single-slot setup with a 988 kB slot starting at 0x100000.

category: Example|Bootloader
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]
  - name: "MCU"
    value: ["Bootloader"]


component:
  - id: bootloader_core
  - id: bootloader_crc
  - id: bootloader_aes_sha_ecdsa
  - id: bootloader_internal_storage
  - id: bootloader_storage_slots
  - id: bootloader_image_parser
  - id: bootloader_common_storage_single
  - id: bootloader_token_management
  - id: bootloader_debug

configuration:
  - name: SLOT0_ENABLE
    value: 1
  - name: SLOT0_SIZE
    value: 1007616
  ## device_sdid_200 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 1048576
    condition: [device_sdid_200]
  - name: SLOT0_START
    value: 1048576
    condition: [device_sdid_200]
  ## device_sdid_205 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 1048576
    condition: [device_sdid_205]
  - name: SLOT0_START
    value: 1048576
    condition: [device_sdid_205]
  ## device_sdid_210 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 135266304
    condition: [device_sdid_210]
  - name: SLOT0_START
    value: 135266304
    condition: [device_sdid_210]
  ## device_sdid_215 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 135266304
    condition: [device_sdid_215]
  - name: SLOT0_START
    value: 135266304
    condition: [device_sdid_215]
  ## device_sdid_220 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 135266304
    condition: [device_sdid_220]
  - name: SLOT0_START
    value: 135266304
    condition: [device_sdid_220]
  ## device_sdid_225 ##
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 135266304
    condition: [device_sdid_225]
  - name: SLOT0_START
    value: 135266304
    condition: [device_sdid_225]
tag:
  - hardware:device:flash:2048

readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
post_build:
  profile: bootloader_series_2
