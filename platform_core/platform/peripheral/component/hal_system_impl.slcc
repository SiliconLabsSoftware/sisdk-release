# This HAL applies to series 2 and 3 devices.
id: hal_system_impl
label: SYSTEM_IMPL
package: platform_core
description: >
  System peripheral API Implementation
category: Platform|Peripheral|HAL
ui_hints:
  visibility: never
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_system.c
provides:
- name: hal_system_impl
- name: hal_generic_system
  condition: [device_series_3]
requires:
- name: device
- name: hal_common
- name: hal_system
- name: cmsis_core
- name: hal_syscfg
- name: enum
- name: status
- name: sl_assert
- name: emlib_cmu
  condition: [device_sdid_240]
- name: emlib_cmu
  condition: [device_generic_family_efr32xg2b]
- name: se_manager
  condition: [device_generic_family_sixx301]
- name: se_manager_device_data
  condition: [device_generic_family_sixx301]
root_path: platform_core/platform/peripheral
