upgrade:
  - sdk:
      id: simplicity_sdk
      version: 4.1.0
    component:
      - trigger: cpc_secondary_driver_spi
        description: |
          Component cpc_secondary_driver_spi now requires a subcomponent that specify the peripheral type.
        add:
          - cpc_secondary_driver_spi_usart
        remove:
          - cpc_secondary_driver_spi
      - trigger: cpc_secondary_driver_uart
        description: |
          Component cpc_secondary_driver_uart now requires a subcomponent that specify the peripheral type.
        add:
          - cpc_secondary_driver_uart_usart
        remove:
          - cpc_secondary_driver_uart
  - sdk:
      id: simplicity_sdk
      version: "2025.6.0"
    component:
      - trigger: cpc_secondary_recommended_interface
        description: >
          In sisdk-2025.6.0 the cpc_secondary_recommended_interface component was renamed cpc_secondary_recommended_uart_interface. Remove the cpc_secondary_recommended_interface component from your project.
        add:
          - cpc_secondary_recommended_uart_interface
        remove:
          - cpc_secondary_recommended_interface
