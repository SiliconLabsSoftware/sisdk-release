project_name: bootloader-storage-single
package: bootloader
quality: production
label: Bootloader - SoC Storage (single OTA image of size 1024kB for 4MB flash)
description: >
  Demonstrates how to configure the Gecko Bootloader to store firmware update images in flash, in a single-slot setup with a 1024 kB slot starting at 0x011F8000.

category: Example|Bootloader
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]
  - name: "MCU"
    value: ["Bootloader"]


component:
  - id: btl_core
  - id: bootloader_aes_sha_ecdsa
  - id: btl_internal_storage
  - id: btl_storage_slots
  - id: btl_image_parser
  - id: btl_common_storage_single
  - id: bootloader_debug
  - id: clock_manager
  - id: btl_crc

configuration:
  - name: SLOT0_ENABLE
    value: 1
  - name: SLOT0_SIZE
    value: 1048576
  - name: SLOT0_START
    value: 18841600
  - name: BTL_STORAGE_BASE_ADDRESS
    value: 18841600
tag:
  - hardware:device:flash:1024

readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
post_build:
  profile: bootloader_series_2
