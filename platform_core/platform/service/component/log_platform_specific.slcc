id: log_platform_specific
label: Log Platform-Specific Implementation
package: platform_core
description: >
  Platform specific calls related to timer module used for timestamps,
  pre sleep and post sleep processes.
  .
  When the power_manager service is also present in the project, this
  component additionally compiles the EM-transition glue: it subscribes
  to power_manager events, suspends the logger across EM2/EM3, and
  back-fills the µs timestamp with elapsed sleep time read from
  sleeptimer (which already abstracts whatever low-frequency RTC the
  target SoC uses). No source from that path is built when
  power_manager is absent.
category: Services|Log
quality: evaluation
metadata:
  sbom:
    license: Zlib
provides:
- name: log_platform_core
requires:
- name: hal_timer
  condition: [device_has_timer]
- name: device_peripheral
  condition: [device_efx]
- name: clock_manager_runtime
  condition: [device_efx]
- name: interrupt_manager
  condition: [device_efx]
- name: sleeptimer
  condition: [power_manager]
root_path: platform_core/platform/service/sl_log/
source:
- path: src/sl_log_platform_specific.c
- path: src/sl_log_power_manager.c
  condition: [power_manager]
include:
- path: inc
  condition: [power_manager]
  file_list:
  - path: sl_log_power_manager.h
template_contribution:
- name: event_handler
  condition: [power_manager]
  value:
    event: service_init
    include: sl_log_power_manager.h
    handler: sli_log_pm_subscribe
  priority: 9999
ui_hints:
  visibility: never
