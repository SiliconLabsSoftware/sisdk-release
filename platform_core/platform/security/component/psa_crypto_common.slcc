id: psa_crypto_common
package: platform_core
label: PSA Crypto Common
description: >-
  This component provides the PSA Crypto common functionality including
  configuration and source implementation.
category: Platform|Security|PSA Crypto
quality: production
ui_hints:
  visibility: never

provides:
- name: psa_crypto_common

requires:
- name: psa_crypto_config
- name: psa_crypto_common_source
  condition: [trustzone_unaware]
- name: psa_crypto_common_source
  condition: [trustzone_secure]

metadata:
  sbom:
    license: Zlib
root_path: platform_core
