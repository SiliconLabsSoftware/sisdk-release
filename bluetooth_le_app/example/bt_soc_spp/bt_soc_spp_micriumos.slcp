project_name: bt_soc_spp_micriumos
package: bluetooth_le_app
label: Bluetooth - SoC Serial Port Profile Micrium OS
description: >-
  Serial Port Profile (SPP) example for Bluetooth wire replacement.  
  This project demonstrates both peripheral and central roles, enabling wireless
  serial communication between devices.
category: Bluetooth Examples
quality: experimental

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Beginner"]

component:
  - id: app_assert
  - id: app_log
  - id: app_os_helper
  - id: bluetooth_stack
  - id: bluetooth_feature_legacy_advertiser
  - id: bluetooth_feature_connection_role_central
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_gatt
  - id: bluetooth_feature_gatt_server
  - id: bluetooth_feature_legacy_scanner
  - id: bluetooth_feature_sm
  - id: bluetooth_feature_system
  - id: clock_manager
  - id: component_catalog
  - id: device_init
  - id: dmd_memlcd
    condition:
      - hardware_board_supports_wstk_lcd
  - id: ble_peer_manager_filter
  - id: ble_peer_manager_central
  - id: ble_peer_manager_peripheral
  - id: gatt_configuration
  - id: gatt_service_device_information_override
  - id: glib
    condition:
      - hardware_board_supports_wstk_lcd
  - id: micriumos_kernel
  - id: mpu
  - id: rail_util_pti
  - id: simple_button
    instance:
      - btn0
  - id: sl_main
  - id: spp

source:
  - path: app.c
  - path: app_display.c
    condition:
      - hardware_board_supports_wstk_lcd
  - path: app_display_stub.c
    unless:
      - hardware_board_supports_wstk_lcd

include:
  - path: .
    file_list:
      - path: app.h
      - path: app_display.h

config_file:
  - override:
      component: gatt_configuration
      file_id: gatt_configuration_file_id
    path: gatt_configuration.btconf
    directory: btconf
  - path: config/app_config.h

template_contribution:
  - name: ble_peer_manager_event_handler
    value:
      include: app.h
      handler: app_on_ble_peer_manager_event

readme:
  - path: readme.md

other_file:
  - path: image/readme_img0.png
  - path: image/readme_img1.png

configuration:
  - name: APP_LOG_LEVEL_FILTER_THRESHOLD
    value: "APP_LOG_LEVEL_INFO"
  - name: CIRCULAR_QUEUE_LEN_MAX
    value: "2049"
  - name: LIB_MEM_CFG_HEAP_SIZE
    value: "6500"
  - name: OS_CFG_TMR_EN
    value: "1"
  - name: OS_CFG_DBG_EN
    value: "0"
  - name: OS_CFG_TS_EN
    value: "0"
  - name: OS_CFG_SCHED_ROUND_ROBIN_EN
    value: "0"
  - name: OS_CFG_STK_SIZE_MIN
    value: "48"
  - name: OS_CFG_Q_EN
    value: "1"
  - name: OS_CFG_MON_EN
    value: "0"
  - name: OS_CFG_STAT_TASK_EN
    value: "0"
  - name: OS_CFG_STAT_TASK_STK_CHK_EN
    value: "0"
  - name: OS_CFG_TASK_PROFILE_EN
    value: "0"
  - name: OS_CFG_TASK_Q_EN
    value: "0"
  - name: SL_BT_RTOS_HOST_STACK_TASK_STACK_SIZE
    value: "4000"
  - name: SL_STACK_SIZE
    value: "2752"
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_BOARD_ENABLE_DISPLAY
    value: "1"

post_build:
  - path: ../../postbuild_profile/bt_common_s2.slpb
    condition:
      - device_series_2
      - bootloader_app_properties

tag:
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:device:device_series_2
  - hwfilter:!device:device_generic_family_efr32xg22
  - hwfilter:board:simple_button:btn0

ui_hints:
  highlight:
    - path: config/btconf/gatt_configuration.btconf
    - path: readme.md
      focus: true
