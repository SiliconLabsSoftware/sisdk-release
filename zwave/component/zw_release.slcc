id: zw_release
label: Z-Wave Release
category: Z-Wave
description: >
  This component is used to optimize the code for production by adjusting
  the toolchain to prioritize a small final binary size.
  Debug information is emitted at compile time (-g) and removed by the linker
  or post-build strip, so the shipped binary stays small while .unstripped.out
  or RelWithDebInfo artifacts can retain symbols and sources.
package: zwave
quality: production
metadata:
  sbom:
    reference: zw_sbom_license
provides:
- name: zw_build_mode
- name: zw_release
define:
- name: NDEBUG
conflicts:
- name: zw_debug
toolchain_settings:
- option: optimize
  value: size
- option: debug_level
  value: default
root_path: zwave
