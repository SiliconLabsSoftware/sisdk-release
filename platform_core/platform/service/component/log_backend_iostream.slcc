id: log_backend_iostream
label: Log Backend I/O Stream
package: platform_core
description: >
  I/O Stream transport layer for the Debug Logger. This component routes log
  output through the Silicon Labs I/O Stream API (UART / VCOM / RTT).
  It requires exactly one output-format implementation: install either
  log_backend_iostream_formatted (human-readable text) or
  log_backend_iostream_compact (raw binary sl_log_event_t records).
  The default log level is set to Error, and users can modify this configuration
  through the UC.
category: Services|Log
quality: evaluation
metadata:
  sbom:
    license: Zlib
provides:
- name: log_backend_iostream
requires:
- name: log_backend_iostream_impl
- name: iostream
- name: iostream_recommended_console
recommends:
- id: log_backend_iostream_compact
  vendor: silabs
root_path: platform_core/platform/service/sl_log
