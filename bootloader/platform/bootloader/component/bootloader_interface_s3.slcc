id: bootloader_interface_s3
label: Bootloader Application Interface Series 3
package: bootloader
description: >
  Bootloader Application Interface component for Series 3. Supplies Series-3 interface
  sources and header helpers only; implementation components (bootloader_app_properties,
  btl_interface_bootloadinfo vs btl_interface_bootloadinfo_single, and whether
  sl_app_properties comes from btl_main or app_properties.c) are selected by the project
  graph. Host or test apps that need btl_storage_bootloadinfo.c should require
  btl_interface_bootloadinfo explicitly. Contributes btl_core_cfg.h (file_id btl_core_config)
  for Series-3 interface and parser code (including app-only projects without btl_core).
category: Platform|Bootloader
quality: production
ui_hints:
  visibility: never
source:
- path: platform/bootloader/series3/api/btl_interface.c
- path: platform/bootloader/series3/api/btl_interface_storage.c
provides:
- name: bootloader_interface_common
  condition: [device_series_3]
- name: bootloader_interface_s3
requires:
- name: bootloader_interface_headers
- name: bootloader_application_properties_header
- name: bootloader_interface_s3_bootload_headers
- name: btl_storage_bootloadinfo_header
- name: btl_interface_bootloadinfo_provider
- name: device_series_3
- name: cmsis_core
- name: device
- name: component_catalog
- name: trustzone_security_state
- name: se_manager
- name: btl_interface_osal
  condition: [cmsis_rtos2]
- name: btl_utils_image_parser
recommends:
- id: btl_interface_bootloadinfo

  vendor: silabs
config_file:
- path: platform/bootloader/series3/config/device_series_3/btl_core_cfg.h
  file_id: btl_core_config

template_contribution:
- name: bootloader_interface_enable
  value: 1
- name: component_catalog
  value: gecko_bootloader_interface
  unless: [btl_core]
- name: event_handler
  value:
    event: platform_init
    include: btl_interface.h
    handler: bootloader_init
  priority: -8000
  unless: [trustzone_nonsecure, omit_bootloader_interface_api_sources]
- name: bootloader_size
  value: 32768
  unless: [test_btl_core]
metadata:
  sbom:
    license: MSLA
documentation:
  docset: mcu-bootloader
  document: group-Interface
root_path: bootloader
