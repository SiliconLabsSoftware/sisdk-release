project_name: mp-zb-ot-ble-rcp-spi
label: Zigbee RCP + OpenThread RCP + BLE RCP - SPI (CMP, DMP)
package: multiprotocol
description: >
  Demonstrates a Multiprotocol 802.15.4 RCP application running OpenThread, Zigbee (CMP/multi-PAN), and BLE (DMP) over SPI using CPC for host communication.
category: OpenThread Examples
quality: production

component:
  - id: sl_main
  - id: ot_crash_handler
  - id: ot_stack_rcp
  - id: ot_ncp_cpc
  - id: cpc_secondary_driver_spi_usart
    instance:
      - exp
    condition: [device_series_2]
  - id: cpc_secondary_driver_spi_eusart
    instance:
      - exp
    condition: [device_series_3]
  - id: rail_util_pti
  - id: bootloader_interface
  - id: freertos
  - id: freertos_heap_3
  - id: bluetooth_hci_cpc
  - id: bluetooth_controller
  - id: bluetooth_feature_connection_role_central
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_advertiser
  - id: bluetooth_feature_connection_phy_update
  - id: bluetooth_feature_legacy_scanner
  - id: bluetooth_feature_extended_scanner
  - id: bluetooth_feature_extended_advertiser
  - id: rail_lib_multiprotocol
  - id: clock_manager
  - id: ot_diags
  - id: ot_reset_utils
  # Platform - Enable LTO for gcc and llvm by installing the following components
  - id: toolchain_gcc_lto
    condition: [toolchain_gcc]
  - id: toolchain_llvm_lto
    condition: [toolchain_llvm]

include:
  - path: .
    file_list:
    - path: app.h

source:
  - path: app.c

configuration:
  - name: SL_BT_CONFIG_USER_ADVERTISERS
    value: 3
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 2752
    condition: [sl_main]
  - name: SL_STACK_SIZE
    value: 2752
  - name: SL_HEAP_SIZE
    value: "15700"
  - name: SL_DEVICE_INIT_LFXO_TIMEOUT
    value: cmuLfxoStartupDelay_4KCycles
    condition: ["device_sdid_200"]
  - name: SL_DEVICE_INIT_LFXO_TIMEOUT
    value: cmuLfxoStartupDelay_4KCycles
    condition: ["device_sdid_205"]
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: OPENTHREAD_CONFIG_HEAP_EXTERNAL_ENABLE
    value: 0
  - name: OPENTHREAD_CONFIG_LOG_OUTPUT
    value: OPENTHREAD_CONFIG_LOG_OUTPUT_NONE
  - name: OPENTHREAD_CONFIG_MULTIPAN_RCP_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_MULTIPLE_INSTANCE_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_MULTIPLE_STATIC_INSTANCE_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_PLATFORM_KEY_REFERENCES_ENABLE
    value: 0
  - name: OPENTHREAD_CONFIG_MAC_CSL_RECEIVER_ENABLE
    value: 0
  - name: OPENTHREAD_CONFIG_MAC_CSL_AUTO_SYNC_ENABLE
    value: 0
  - name: SL_CPC_RX_BUFFER_MAX_COUNT
    value: 15
  - name: SL_CPC_TX_QUEUE_ITEM_MAX_COUNT
    value: 15
  - name: CIRCULAR_QUEUE_LEN_MAX
    value: 16
  - name: SL_OPENTHREAD_STACK_TASK_MEM_SIZE
    value: 4608
  - name: SL_BTCTRL_RTOS_LINK_LAYER_TASK_STACK_SIZE
    value: 1100
    condition: [toolchain_lto, freertos]
    unless: [device_series_3]
  
template_contribution:
  - name: component_catalog
    value: bluetooth_ncp

tag:
  - prebuilt_demo
  - hardware:component:exp_header:spi
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:device:device_supports_thread
  - hwfilter:board:hardware_board_has_spi
  - toolchain:gcc
  - toolchain:llvm

readme:
  - path: ./README.md

filter:
  - name: "Wireless Technology"
    value: ["Thread", "Zigbee", "Bluetooth"]
  - name: "Device Type"
    value: ["RCP"]
  - name: "Capability"
    value: ["Multiprotocol"]
  - name: "Project Difficulty"
    value: ["Advanced"]

ui_hints:
  highlight:
    - path: ./README.md
      focus: true
