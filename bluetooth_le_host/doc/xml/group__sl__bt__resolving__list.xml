      <memberdef kind="function" id="group__sl__bt__resolving__list_1ga756f9d30cb9e86853a9c8d02048a61f9" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>sl_status_t</type>
        <definition>sl_status_t sl_bt_resolving_list_add_device_by_address</definition>
